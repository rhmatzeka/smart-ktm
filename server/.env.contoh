# Salin jadi server/.env lalu isi.

# AI agent (Gemini). Kosong = chat jalan di mode offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Akun demo yang dibuat saat database pertama kali diisi (atau saat --reset).
# Isi NIM & nama asli supaya KTM-mu bisa ditautkan ke akun demo yang punya riwayat.
DEMO_NIM=231011400001
DEMO_NAMA=Rahmat
DEMO_PIN=123456
DOSEN_NIDN=0400000001
DOSEN_PIN=123456

# Blockchain. Diisi otomatis oleh scripts/chain-lokal.sh untuk Anvil,
# atau isi manual untuk testnet (mis. Polygon Amoy / Monad testnet).
CHAIN_RPC=
CHAIN_PRIVATE_KEY=
CHAIN_KONTRAK=
CHAIN_EXPLORER=

HOST=127.0.0.1
PORT=8080
