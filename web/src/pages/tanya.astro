---
import Dasar from '../layouts/Dasar.astro';
import { ikon, ikonApp } from '../lib/ikon';
---
<Dasar judul="Tanya AI" nav="tanya">
  <header class="atas-putih kepala-ai">
    <Fragment set:html={ikonApp('kilau', 'oranye')} />
    <div>
      <h1 class="judul-ai">AI Agent</h1>
      <p class="redup kecil"><span class="titik-hidup"></span> Bisa lihat jadwal, tugas, kehadiran, dan buat pengingat</p>
    </div>
  </header>

  <section class="zona-biru zona-chat">
    <div class="obrolan" id="obrolan" aria-live="polite">
      <div class="gelembung ai">Hai! Aku AI agent Smart KTM. Mau tanya jadwal, deadline, atau minta diingatkan sesuatu?</div>
    </div>

    <div class="saran" id="saran">
      <button type="button">Minggu ini deadline apa aja?</button>
      <button type="button">Besok kuliah jam berapa?</button>
      <button type="button">Absenku aman nggak?</button>
      <button type="button">Ingatkan aku ngerjain ERD jam 7 malam ini</button>
    </div>

    <form id="form" class="ketik">
      <label for="isi" class="sr">Pesan</label>
      <input id="isi" name="isi" placeholder="Tulis pertanyaan…" autocomplete="off" required />
      <button class="kirim" type="submit" aria-label="Kirim"><Fragment set:html={ikon('kirim')} /></button>
    </form>
  </section>
</Dasar>

<style is:global>
  .kepala-ai { display: flex; gap: 14px; align-items: center; }
  .kepala-ai .app-ikon { width: 52px; height: 52px; border-radius: 50%; border: 1px solid var(--garis); }
  .kepala-ai .app-ikon .ikon { width: 26px; height: 26px; }
  .judul-ai { font-size: 1.5rem; font-weight: 800; }
  .titik-hidup { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--hijau); margin-right: 4px; }
  .zona-chat { display: flex; flex-direction: column; }
  .obrolan { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .gelembung { max-width: 86%; padding: 11px 14px; border-radius: 18px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.92rem; line-height: 1.45; }
  .gelembung.saya { align-self: flex-end; background: var(--kuning); color: #1f2a44; border-bottom-right-radius: 6px; font-weight: 600; }
  .gelembung.ai { align-self: flex-start; background: var(--putih); color: var(--teks); border-bottom-left-radius: 6px; box-shadow: var(--bayang); }
  .gelembung.menunggu { color: var(--teks-2); }
  .aksi { align-self: flex-start; display: flex; gap: 6px; align-items: center; font-size: 0.82rem; font-weight: 700; background: #dcfce7; color: var(--hijau); padding: 6px 12px; border-radius: 99px; }
  .aksi .ikon { width: 15px; height: 15px; stroke-width: 3; }
  .mode { align-self: flex-start; font-size: 0.75rem; color: rgba(255, 255, 255, 0.7); }
  .saran { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 12px; }
  .saran button {
    border: 1px solid rgba(255, 255, 255, 0.4); background: rgba(255, 255, 255, 0.1); color: var(--putih);
    border-radius: 99px; padding: 8px 14px; font: 600 0.85rem var(--font); cursor: pointer;
  }
  .ketik {
    position: sticky; bottom: 86px; display: flex; gap: 8px; padding: 6px;
    background: var(--putih); border-radius: 18px; box-shadow: var(--bayang);
  }
  .ketik input { background: transparent; border: 0; min-height: 46px; }
  .kirim { width: 46px; height: 46px; border: 0; border-radius: 14px; background: var(--biru); color: var(--putih); display: grid; place-items: center; cursor: pointer; flex: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  import { api, tanganiGalat } from '../lib/api';
  import { ikon } from '../lib/ikon';

  type Pesan = { peran: 'user' | 'model'; teks: string };
  const KUNCI = 'smartktm.obrolan';
  const obrolan = document.getElementById('obrolan')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const isi = document.getElementById('isi') as HTMLInputElement;
  let riwayat: Pesan[] = [];
  try { riwayat = JSON.parse(sessionStorage.getItem(KUNCI) || '[]'); } catch { riwayat = []; }

  function tambah(kelas: string, teks: string, html = false) {
    const el = document.createElement('div');
    el.className = kelas;
    if (html) el.innerHTML = teks; else el.textContent = teks;
    obrolan.appendChild(el);
    el.scrollIntoView({ block: 'end', behavior: 'smooth' });
    return el;
  }
  const simpan = () => { try { sessionStorage.setItem(KUNCI, JSON.stringify(riwayat.slice(-20))); } catch { /* abaikan */ } };
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  // Model kadang menjawab dengan markdown ringan: **tebal** dan daftar "- ".
  const rapikan = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/^\s*[-*] /gm, '• ');
  const balasanAi = (teks: string) => tambah('gelembung ai', rapikan(teks), true);

  riwayat.forEach((p) => (p.peran === 'user' ? tambah('gelembung saya', p.teks) : balasanAi(p.teks)));

  async function kirim(teks: string) {
    tambah('gelembung saya', teks);
    const tunggu = tambah('gelembung ai menunggu', 'Sedang mengecek data kamu…');
    isi.value = '';
    isi.disabled = true;
    try {
      const r = await api<{ balasan: string; aksi: string[]; mode: string }>('/chat', { pesan: teks, riwayat });
      tunggu.remove();
      r.aksi.forEach((a) => tambah('aksi', `${ikon('centang')} ${esc(a)}`, true));
      balasanAi(r.balasan);
      if (r.mode === 'offline') tambah('mode', 'Mode offline: kunci AI belum diatur di server.');
      riwayat.push({ peran: 'user', teks }, { peran: 'model', teks: r.balasan });
      simpan();
    } catch (e) {
      tunggu.remove();
      tanganiGalat(e, (t) => tambah('gelembung ai', `Gagal: ${t}`));
    } finally {
      isi.disabled = false;
      isi.focus();
    }
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const t = isi.value.trim();
    if (t) kirim(t);
  });
  document.getElementById('saran')!.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button');
    if (b) kirim(b.textContent!.trim());
  });
</script>
