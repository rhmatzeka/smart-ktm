---
import Dasar from '../layouts/Dasar.astro';
import { ikon } from '../lib/ikon';
---
<Dasar judul="Tanya" nav="tanya">
  <header class="pita-tanya">
    <div class="pita-atas"><span>Asisten KTM</span><button class="hapus-obrolan" id="hapus" type="button" hidden>Obrolan baru</button></div>
    <h1>Tanya soal kuliahmu</h1>
    <p>Jawaban dari jadwal dan presensi MyUnpam kamu</p>
    <div class="chip-konteks" id="konteks"><span>Memuat data kamu…</span></div>
  </header>

  <section class="isi-chat">
    <!-- Konteks + saran, hanya saat obrolan masih kosong -->
    <div id="kosong">
      <p class="label-bagian">Coba tanyakan</p>
      <ul class="saran" id="saran"></ul>
    </div>

    <div class="obrolan" id="obrolan" aria-live="polite"></div>
  </section>

  <form id="form" class="ketik">
    <label for="isi" class="sr">Pesan</label>
    <input id="isi" name="isi" placeholder="Tulis pertanyaan…" autocomplete="off" required />
    <button class="kirim" type="submit" aria-label="Kirim"><Fragment set:html={ikon('kirim')} /></button>
  </form>
</Dasar>

<style is:global>
  body:has(.pita-tanya) .halaman { background: var(--latar); }
  .pita-tanya {
    position: relative; overflow: hidden; color: var(--putih); padding: 14px 16px 16px;
    border-radius: 0 0 22px 22px; background: linear-gradient(135deg, #3b7bf6, var(--biru) 60%, var(--biru-tua));
  }
  .pita-tanya::after { content: ''; position: absolute; inset: -60% -20%; pointer-events: none; background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.16) 50%, transparent 58%); }
  .pita-tanya > * { position: relative; z-index: 1; }
  .pita-tanya .pita-atas { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; opacity: 0.9; min-height: 26px; }
  .pita-tanya h1 { font-size: 1.35rem; font-weight: 800; margin-top: 8px; }
  .pita-tanya p { font-size: 0.82rem; opacity: 0.88; }
  .hapus-obrolan { border: 0; background: rgba(255, 255, 255, 0.18); color: var(--putih); font: 700 0.75rem var(--font); padding: 5px 10px; border-radius: 8px; cursor: pointer; }
  .chip-konteks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .chip-konteks span { display: inline-flex; align-items: center; gap: 5px; background: rgba(255, 255, 255, 0.16); border-radius: 8px; padding: 4px 9px; font-size: 0.75rem; font-weight: 600; }
  .chip-konteks .ikon { width: 13px; height: 13px; }
  .chip-konteks .merah { background: rgba(229, 72, 77, 0.35); }

  .isi-chat { flex: 1; padding: 16px 16px 150px; }
  .label-bagian { font-size: 0.78rem; font-weight: 700; color: var(--teks-2); margin: 4px 2px 8px; }
  .konteks { background: var(--putih); border: 1px solid var(--garis); border-radius: 16px; margin-bottom: 18px; }
  .konteks-baris { display: flex; gap: 10px; align-items: center; padding: 12px 14px; font-size: 0.86rem; }
  .konteks-baris + .konteks-baris { border-top: 1px solid #eef1f6; }
  .konteks-baris .ikon { width: 18px; height: 18px; color: var(--biru); }
  .konteks-baris b { font-weight: 700; }
  .konteks-baris .merah { color: var(--merah); }

  .saran { list-style: none; margin: 0; padding: 0; background: var(--putih); border: 1px solid var(--garis); border-radius: 16px; }
  .saran li + li { border-top: 1px solid #eef1f6; }
  .saran button {
    width: 100%; display: flex; gap: 10px; align-items: center; text-align: left; cursor: pointer;
    background: none; border: 0; padding: 13px 14px; font: 600 0.88rem var(--font); color: var(--teks);
  }
  .saran button .ikon { width: 18px; height: 18px; color: var(--teks-2); flex: none; }
  .saran button span { flex: 1; }
  .saran button .panah { transform: rotate(180deg); }

  .obrolan { display: flex; flex-direction: column; gap: 10px; }
  .gelembung { max-width: 85%; padding: 10px 14px; border-radius: 18px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.92rem; line-height: 1.5; }
  .gelembung.saya { align-self: flex-end; background: var(--biru); color: var(--putih); border-bottom-right-radius: 6px; }
  .gelembung.ai { align-self: flex-start; background: var(--putih); color: var(--teks); border: 1px solid var(--garis); border-bottom-left-radius: 6px; }
  .gelembung.menunggu { color: var(--teks-2); }
  .gelembung.menunggu::after { content: ''; display: inline-block; width: 1em; animation: titik 1.2s steps(4) infinite; }
  @keyframes titik { 0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '...'; } }
  .aksi { align-self: flex-start; display: flex; gap: 8px; align-items: center; font-size: 0.8rem; font-weight: 600; color: var(--teks); background: var(--putih); border: 1px solid var(--garis); border-left: 3px solid var(--hijau); padding: 8px 12px; border-radius: 10px; }
  .aksi .ikon { width: 15px; height: 15px; color: var(--hijau); stroke-width: 3; flex: none; }
  .mode { align-self: flex-start; font-size: 0.75rem; color: var(--teks-2); }

  .ketik {
    position: fixed; left: 50%; transform: translateX(-50%); bottom: 62px; z-index: 15;
    width: 100%; max-width: 480px; display: flex; gap: 8px; padding: 10px 14px;
    background: var(--latar);
  }
  .ketik input { flex: 1; background: var(--putih); border: 1px solid var(--garis); border-radius: 13px; min-height: 44px; }
  .kirim { width: 44px; height: 44px; border: 0; border-radius: 14px; background: var(--biru); color: var(--putih); display: grid; place-items: center; cursor: pointer; flex: none; }
  .kirim:disabled { opacity: 0.5; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  import { api, esc, tanganiGalat } from '../lib/api';
  import { jadwalkanNotif } from '../lib/notif';
  import { ikon } from '../lib/ikon';

  type Pesan = { peran: 'user' | 'model'; teks: string };
  const KUNCI = 'smartktm.obrolan';
  const $ = (id: string) => document.getElementById(id)!;
  const obrolan = $('obrolan');
  const form = $('form') as HTMLFormElement;
  const isi = $('isi') as HTMLInputElement;
  let riwayat: Pesan[] = [];
  try { riwayat = JSON.parse(sessionStorage.getItem(KUNCI) || '[]'); } catch { riwayat = []; }

  // Model kadang menjawab dengan markdown ringan: **tebal** dan daftar "- ".
  const rapikan = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/^\s*[-*] /gm, '• ');

  function tambah(kelas: string, isiHtml: string) {
    const el = document.createElement('div');
    el.className = kelas;
    el.innerHTML = isiHtml;
    obrolan.appendChild(el);
    el.scrollIntoView({ block: 'end', behavior: 'smooth' });
    return el;
  }
  const simpan = () => { try { sessionStorage.setItem(KUNCI, JSON.stringify(riwayat.slice(-20))); } catch { /* abaikan */ } };
  const keadaanKosong = () => {
    const kosong = riwayat.length === 0 && !obrolan.children.length;
    $('kosong').hidden = !kosong;
    $('hapus').hidden = kosong;
  };

  riwayat.forEach((p) => tambah(`gelembung ${p.peran === 'user' ? 'saya' : 'ai'}`, p.peran === 'user' ? esc(p.teks) : rapikan(p.teks)));
  keadaanKosong();

  async function kirim(teks: string) {
    tambah('gelembung saya', esc(teks));
    keadaanKosong();
    const tunggu = tambah('gelembung ai menunggu', 'Membuka data kamu');
    isi.value = '';
    isi.disabled = true;
    try {
      const r = await api<{ balasan: string; aksi: string[]; mode: string }>('/chat', { pesan: teks, riwayat });
      tunggu.remove();
      r.aksi.forEach((a) => tambah('aksi', `${ikon('centang')}<span>${esc(a)}</span>`));
      // Pengingat atau tugas baru dari asisten langsung dijadwalkan jadi notifikasi HP.
      if (r.aksi.length) jadwalkanNotif(false);
      tambah('gelembung ai', rapikan(r.balasan));
      if (r.mode === 'offline') tambah('mode', 'Mode offline: kunci AI belum diatur di server.');
      riwayat.push({ peran: 'user', teks }, { peran: 'model', teks: r.balasan });
      simpan();
    } catch (e) {
      tunggu.remove();
      tanganiGalat(e, (t) => tambah('gelembung ai', `Gagal: ${esc(t)}`));
    } finally {
      isi.disabled = false;
      isi.focus();
      keadaanKosong();
    }
  }

  // Konteks hari ini + saran pertanyaan dari data mahasiswa sendiri.
  async function muatKonteks() {
    try {
      const b = await api<any>('/beranda');
      const k = b.kelas_berlangsung || b.kelas_berikut || (b.momen === 'malam' ? b.jadwal_besok[0] : null);
      const terlewat = b.presensi.filter((p: any) => p.belum_presensi?.length);
      const nTerlewat = terlewat.reduce((n: number, p: any) => n + p.belum_presensi.length, 0);
      const chip: string[] = [];
      chip.push(k ? `<span>${ikon('kalender')}${b.kelas_berlangsung ? 'Sekarang' : b.momen === 'malam' ? 'Besok' : 'Berikutnya'}: ${esc(k.nama.split(' ').slice(0, 3).join(' '))} ${k.mulai.replace(':', '.')}</span>` : `<span>${ikon('kalender')}Tidak ada kelas lagi hari ini</span>`);
      chip.push(`<span class="${nTerlewat ? 'merah' : ''}">${ikon('peringatan')}${nTerlewat} pertemuan terlewat</span>`);
      chip.push(`<span>${ikon('tugas')}${b.tugas.length} tugas</span>`);
      $('konteks').innerHTML = chip.join('');

      const saran: [string, string][] = [];
      if (terlewat[0]) saran.push(['peringatan', `${terlewat[0].matkul}: pertemuan ${terlewat[0].belum_presensi.join(', ')} belum presensi, aku harus apa?`]);
      saran.push(['kalender', b.momen === 'malam' ? 'Besok kuliah apa aja dan di ruang mana?' : 'Habis ini kuliah apa dan di ruang mana?']);
      saran.push(['tugas', 'Catat tugas: ']);
      saran.push(['jam', 'Ingatkan aku belajar jam 7 malam ini']);
      $('saran').innerHTML = saran
        .map(([i, t]) => `<li><button type="button" data-teks="${esc(t)}">${ikon(i)}<span>${esc(t.endsWith(': ') ? 'Catat tugas baru…' : t)}</span>${ikon('kembali', 'ikon panah')}</button></li>`)
        .join('');
    } catch (e) {
      tanganiGalat(e, () => ($('konteks').innerHTML = '<div class="konteks-baris redup">Data belum bisa dimuat.</div>'));
    }
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const t = isi.value.trim();
    if (t) kirim(t);
  });
  $('saran').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-teks]');
    if (!b) return;
    const t = b.dataset.teks!;
    // "Catat tugas: " diisi sendiri oleh pengguna.
    if (t.endsWith(': ')) { isi.value = t; isi.focus(); return; }
    kirim(t);
  });
  $('hapus').addEventListener('click', () => {
    riwayat = [];
    simpan();
    obrolan.innerHTML = '';
    keadaanKosong();
  });

  if (!riwayat.length) muatKonteks();
  else { muatKonteks(); }
</script>
