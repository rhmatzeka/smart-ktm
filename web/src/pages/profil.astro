---
import Dasar from '../layouts/Dasar.astro';
import Kartu from '../components/Kartu.astro';
import { ikon } from '../lib/ikon';
const panah = ikon('kembali', 'ikon panah');
---
<Dasar judul="Profil" nav="profil">
  <header class="pita-profil">
    <div class="pita-atas"><span>Universitas Pamulang</span><span>Kartu Tanda Mahasiswa</span></div>
    <div class="pp-id">
      <span class="foto-profil" id="foto">·</span>
      <div class="identitas-teks">
        <b id="nama">Memuat…</b>
        <span id="nim"></span>
        <span id="prodi"></span>
      </div>
    </div>
    <div class="pp-angka">
      <div><b id="a-hadir">–</b><span>Kehadiran</span></div>
      <div><b id="a-sks">–</b><span>SKS</span></div>
      <div><b id="a-chain">–</b><span>On-chain</span></div>
    </div>
  </header>

  <section class="isi-profil">
    <div class="banner-hilang" id="banner-hilang" hidden>
      <b>KTM kamu sedang diblokir (dilaporkan hilang)</b>
      <span>Tidak bisa dipakai masuk, presensi, atau check-in acara. Dapat KTM baru? Tap di halaman masuk, lalu isi NIM dan PIN.</span>
      <button class="tombol kecil-saja" id="ketemu" type="button">KTM sudah ketemu</button>
    </div>
    <!-- Aksi -->
    <p class="label-bagian">Akun</p>
    <ul class="daftar-aksi">
      <li><a href="/sinkron/"><Fragment set:html={ikon('kalender')} /><span><b>Sinkron jadwal MyUnpam</b><small>Ambil jadwal, presensi, dan foto terbaru</small></span><Fragment set:html={panah} /></a></li>
      <li><button type="button" id="buka-ktm"><Fragment set:html={ikon('kartu')} /><span><b>KTM digital</b><small>Tampilkan kartu di layar · <span id="ktm-status"></span></small></span><Fragment set:html={panah} /></button></li>
      <li class="ktm-digital" id="ktm-digital" hidden><Kartu /></li>
      <li><button type="button" id="buka-publik"><Fragment set:html={ikon('orang')} /><span><b>Profil publik</b><small id="ringkas-publik">Bio, GitHub, dan portofolio di kartu nama</small></span><Fragment set:html={panah} /></button></li>
      <li><a href="/sertifikat/"><Fragment set:html={ikon('perisai')} /><span><b>Sertifikat saya</b><small id="ringkas-sert">Sertifikat acara on-chain</small></span><Fragment set:html={panah} /></a></li>
      <li><a href="/verifikasi/"><Fragment set:html={ikon('rantai')} /><span><b>Cek bukti kehadiran</b><small>Lihat catatan presensi di blockchain</small></span><Fragment set:html={panah} /></a></li>
      <li><a href="/privasi/"><Fragment set:html={ikon('perisai')} /><span><b>Privasi dan data</b><small>Data apa yang dipakai dan cara menghapusnya</small></span><Fragment set:html={panah} /></a></li>
    </ul>

    <!-- Profil publik (dibuka dari daftar Akun) -->
    <form class="blok-form" id="form" hidden>
      <p class="judul-form">Profil publik, terlihat saat KTM-mu ditap orang lain</p>
      <label for="bio">Bio singkat</label>
      <textarea id="bio" name="bio" rows="2" maxlength="160" placeholder="Contoh: Suka web3, IoT, dan AI agent"></textarea>
      <div class="dua-kolom">
        <div>
          <label for="github">GitHub</label>
          <input id="github" name="github" autocomplete="off" placeholder="username" />
        </div>
        <div>
          <label for="portofolio">Portofolio</label>
          <input id="portofolio" name="portofolio" placeholder="contoh.my.id" />
        </div>
      </div>
      <label class="saklar"><input type="checkbox" id="publik" name="publik" /><span>Tampilkan profil saat KTM ditap orang lain</span></label>
      <div class="baris-simpan">
        <span class="tersimpan" id="tersimpan" role="status"></span>
        <button class="tombol kecil-saja" type="submit">Simpan</button>
      </div>
    </form>

    <p class="label-bagian">Keamanan</p>
    <ul class="daftar-aksi">
      <li><label class="baris-saklar"><Fragment set:html={ikon('perisai')} /><span><b>Minta PIN setiap tap KTM</b><small>Mati: tap KTM langsung masuk. Nyalakan kalau HP sering dipinjam.</small></span><input type="checkbox" id="pin-tap" /></label></li>
      <li><button type="button" id="buka-pin"><Fragment set:html={ikon('kunci')} /><span><b>Ganti PIN</b><small>PIN dipakai untuk masuk pakai NIM dan di HP baru</small></span><Fragment set:html={panah} /></button></li>
      <li><button type="button" id="buka-hilang"><Fragment set:html={ikon('peringatan')} /><span><b>Laporkan KTM hilang</b><small>Blokir kartu dan tampilkan kontakmu ke penemu</small></span><Fragment set:html={panah} /></button></li>
    </ul>
    <ul class="daftar-aksi" id="baris-hapus">
      <li><button type="button" id="buka-hapus"><Fragment set:html={ikon('keluar')} /><span><b>Hapus akun dan data</b><small>Permanen: jadwal, presensi, riwayat, dan akun dihapus dari server</small></span><Fragment set:html={panah} /></button></li>
    </ul>
    <form class="blok-form" id="form-hapus" hidden>
      <p class="judul-form">Semua datamu di Smart KTM dihapus permanen: akun, KTM tertaut, jadwal, presensi, sertifikat, dan riwayat. Bukti di blockchain tetap ada tapi hanya hash yang tidak bisa dikaitkan lagi ke kamu.</p>
      <label for="pin-hapus">Masukkan PIN untuk konfirmasi</label>
      <input id="pin-hapus" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
      <div class="baris-simpan"><button class="tombol kecil-saja merah" type="submit">Hapus akun saya</button></div>
    </form>
    <p class="label-bagian">Riwayat pemakaian KTM</p>
    <div class="kotak-jejak">
      <p class="ket-jejak">Setiap kali KTM-mu dipakai: masuk, presensi, check-in acara, atau ditempel orang. Ada yang bukan kamu? Tekan <b>Bukan saya</b>: KTM langsung diblokir dan presensinya ditandai ke dosen.</p>
      <ul class="daftar-jejak" id="daftar-jejak"><li class="kosong">Memuat…</li></ul>
    </div>

    <form class="blok-form" id="form-pin" hidden>
      <p class="judul-form">Setelah PIN diganti, HP lain harus memasukkan PIN baru sekali sebelum bisa tap KTM tanpa PIN.</p>
      <div class="dua-kolom">
        <div><label for="pin-lama">PIN lama</label><input id="pin-lama" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required /></div>
        <div><label for="pin-baru">PIN baru</label><input id="pin-baru" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="new-password" required /></div>
      </div>
      <div class="baris-simpan"><span class="tersimpan" id="pin-ok" role="status"></span><button class="tombol kecil-saja" type="submit">Ganti PIN</button></div>
    </form>

    <form class="blok-form" id="form-hilang" hidden>
      <p class="judul-form">Kalau KTM-mu ditemukan dan ditap orang lain, mereka akan melihat pesan ini.</p>
      <label for="pesan-hilang">Pesan untuk penemu</label>
      <textarea id="pesan-hilang" rows="2" maxlength="160" placeholder="Contoh: Tolong hubungi WA 08xx atau titip ke BAAK"></textarea>
      <div class="baris-simpan"><button class="tombol kecil-saja merah" type="submit">Blokir KTM ini</button></div>
    </form>

    <button class="keluar" id="keluar" type="button"><Fragment set:html={ikon('keluar')} /> Keluar dari perangkat ini</button>
    <p id="pesan" class="pesan-galat" role="alert" hidden></p>
  </section>
</Dasar>

<style is:global>
  body:has(.isi-profil) .halaman { background: var(--latar); }
  .pita-profil {
    position: relative; overflow: hidden; color: var(--putih); padding: 14px 16px 16px;
    border-radius: 0 0 22px 22px; background: linear-gradient(135deg, #3b7bf6, var(--biru) 60%, var(--biru-tua));
  }
  .pita-profil::after { content: ''; position: absolute; inset: -60% -20%; pointer-events: none; background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.16) 50%, transparent 58%); }
  .pita-profil > * { position: relative; z-index: 1; }
  .pita-profil .pita-atas { display: flex; justify-content: space-between; font-size: 0.75rem; opacity: 0.85; }
  .pp-id { display: flex; gap: 12px; align-items: center; margin-top: 12px; }
  .pita-profil .foto-profil { border: 2px solid rgba(255, 255, 255, 0.85); background: rgba(255, 255, 255, 0.18); color: var(--putih); }
  .pita-profil .identitas-teks span { color: rgba(255, 255, 255, 0.9); }
  .pp-angka { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
  .pp-angka div { background: rgba(255, 255, 255, 0.16); border-radius: 11px; padding: 8px; text-align: center; }
  .pp-angka b { display: block; font-size: 1.1rem; font-weight: 800; }
  .pp-angka span { font-size: 0.7rem; opacity: 0.85; }
  .judul-form { font-size: 0.8rem; font-weight: 700; color: var(--teks-2); margin-top: 10px; }
  .daftar-info { border-top: 1px solid var(--garis) !important; border-radius: 16px !important; margin-top: 2px; }
  .daftar-info li:first-child { border-top: 0; }
  .isi-profil { flex: 1; padding: 14px 16px 100px; }
  .label-bagian { font-size: 0.78rem; font-weight: 700; color: var(--teks-2); margin: 18px 2px 8px; }

  .identitas-tidak-dipakai { display: flex; gap: 12px; align-items: center; background: var(--putih); border: 1px solid var(--garis); border-radius: 16px 16px 0 0; padding: 14px; }
  .foto-profil { width: 56px; height: 66px; border-radius: 10px; overflow: hidden; flex: none; display: grid; place-items: center; font-weight: 800; font-size: 1.2rem; background: var(--biru-pudar); color: var(--biru); }
  .foto-profil img { width: 100%; height: 100%; object-fit: cover; }
  .identitas-teks { display: flex; flex-direction: column; min-width: 0; }
  .identitas-teks b { font-size: 1.05rem; font-weight: 800; }
  .identitas-teks span { font-size: 0.8rem; color: var(--teks-2); }

  .daftar-info, .daftar-aksi { list-style: none; margin: 0; padding: 0; background: var(--putih); border: 1px solid var(--garis); }
  .daftar-info { border-top: 0; border-radius: 0 0 16px 16px; }
  .daftar-aksi { border-radius: 16px; overflow: hidden; }
  .daftar-info li { display: flex; gap: 10px; align-items: center; padding: 10px 14px; font-size: 0.85rem; border-top: 1px solid #eef1f6; }
  .daftar-info li span { color: var(--teks-2); }
  .daftar-info li b { margin-left: auto; font-weight: 700; text-align: right; }
  .daftar-info .ikon, .daftar-aksi .ikon { width: 18px; height: 18px; color: var(--biru); flex: none; }
  .daftar-aksi li + li { border-top: 1px solid #eef1f6; }
  .daftar-aksi a, .daftar-aksi button {
    width: 100%; display: flex; gap: 12px; align-items: center; padding: 12px 14px; text-align: left;
    background: none; border: 0; color: var(--teks); text-decoration: none; font: inherit; cursor: pointer;
  }
  .daftar-aksi span { flex: 1; display: flex; flex-direction: column; }
  .daftar-aksi b { font-size: 0.9rem; font-weight: 700; }
  .daftar-aksi small { font-size: 0.75rem; color: var(--teks-2); }
  .daftar-aksi .panah { transform: rotate(180deg); color: var(--teks-2); width: 16px; height: 16px; }
  .ktm-digital { padding: 12px 14px; }

  .blok-form { margin-top: 12px; background: var(--putih); border: 1px solid var(--garis); border-radius: 16px; padding: 4px 14px 14px; }
  .blok-form label { font-size: 0.8rem; margin: 10px 0 5px; }
  .blok-form textarea { min-height: 0; }
  .dua-kolom { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .saklar { display: flex; gap: 10px; align-items: center; font-weight: 500; margin-top: 12px; }
  .saklar input { width: 18px; min-height: 18px; height: 18px; accent-color: var(--biru); }
  .baris-simpan { display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 12px; }
  .tersimpan { color: var(--hijau); font-size: 0.8rem; font-weight: 700; }

  .baris-saklar { display: flex; gap: 12px; align-items: center; padding: 12px 14px; margin: 0; font: inherit; cursor: pointer; }
  .baris-saklar span { flex: 1; display: flex; flex-direction: column; }
  .baris-saklar b { font-size: 0.9rem; font-weight: 700; }
  .baris-saklar small { font-size: 0.75rem; color: var(--teks-2); font-weight: 400; }
  .baris-saklar input { width: 20px; height: 20px; min-height: 0; accent-color: var(--biru); flex: none; }
  .kotak-jejak { background: var(--putih); border: 1px solid var(--garis); border-radius: 16px; padding: 12px 14px; }
  .ket-jejak { margin: 0 0 10px; font-size: 0.75rem; color: var(--teks-2); }
  .daftar-jejak { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .daftar-jejak li { display: flex; gap: 10px; align-items: center; padding: 8px 0; }
  .daftar-jejak li + li { border-top: 1px solid #eef1f6; }
  .daftar-jejak .isi-jejak { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .daftar-jejak .isi-jejak b { font-size: 0.82rem; font-weight: 600; }
  .daftar-jejak .isi-jejak small { font-size: 0.72rem; color: var(--teks-2); }
  .daftar-jejak .ditolak b { color: #9f1239; }
  .daftar-jejak .bukan-saya { flex: none; font: inherit; font-size: 0.75rem; font-weight: 700; color: #be123c; background: none; border: 1px solid #fecdd3; border-radius: 999px; padding: 4px 10px; }
  .daftar-jejak .disanggah { flex: none; font-size: 0.72rem; color: var(--teks-2); }
  .daftar-jejak .kosong { font-size: 0.8rem; color: var(--teks-2); }
  .banner-hilang { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; margin-bottom: 4px; border-radius: 14px; background: #fff1f2; border: 1px solid #fecdd3; color: #9f1239; }
  .banner-hilang b { font-size: 0.9rem; }
  .banner-hilang span { font-size: 0.78rem; }
  .banner-hilang .tombol { align-self: flex-start; margin-top: 6px; }
  .tombol.merah { background: var(--merah); }
  .keluar { margin-top: 18px; width: 100%; display: flex; gap: 8px; align-items: center; justify-content: center; padding: 12px; border-radius: 14px; border: 1px solid var(--garis); background: var(--putih); color: var(--merah); font: 700 0.88rem var(--font); cursor: pointer; }
  .keluar .ikon { width: 18px; height: 18px; }
  .pesan-galat { margin-top: 10px; padding: 10px 12px; border-radius: 12px; background: #fff1f2; color: #9f1239; font-size: 0.85rem; font-weight: 600; }
</style>

<script>
  import { api, esc, perangkat, sesi, tanganiGalat } from '../lib/api';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const salah = (t: string) => { $('pesan').textContent = t; $('pesan').hidden = !t; };

  api<any>('/saya')
    .then((s) => {
      if (s.foto) {
        const img = document.createElement('img');
        img.src = s.foto;
        img.alt = '';
        $('foto').replaceChildren(img);
      } else $('foto').textContent = s.nama.split(/\s+/).slice(0, 2).map((k: string) => k.charAt(0)).join('');
      $('nama').textContent = s.nama;
      $('nim').textContent = s.nim;
      $('prodi').textContent = [s.prodi || (s.peran === 'dosen' ? 'Dosen' : ''), s.semester && `Semester ${s.semester}`].filter(Boolean).join(' · ');
      $('ktm-status').textContent = s.ktm ? 'KTM fisik tertaut' : 'KTM fisik belum tertaut';
      const isi = (k: string, v: string) => (document.querySelector(`[data-isi=${k}]`)!.textContent = v);
      isi('nama', s.nama);
      isi('nim', s.nim);
      isi('prodi', s.prodi);
      $<HTMLTextAreaElement>('bio').value = s.bio;
      $<HTMLInputElement>('github').value = s.github;
      $<HTMLInputElement>('portofolio').value = s.portofolio;
      $<HTMLInputElement>('publik').checked = s.publik;
      $('banner-hilang').hidden = !s.hilang;
      $('baris-hapus').hidden = s.peran === 'dosen';
      ($('pin-tap') as HTMLInputElement).checked = !!s.pin_tap;
      $('buka-hilang').closest('ul')!.hidden = !!s.hilang;
      if (s.hilang_pesan) ($('pesan-hilang') as HTMLTextAreaElement).value = s.hilang_pesan;
      const isiPublik = [s.bio && 'bio', s.github && 'GitHub', s.portofolio && 'portofolio'].filter(Boolean);
      $('ringkas-publik').textContent = isiPublik.length ? `Terisi: ${isiPublik.join(', ')}` : 'Belum diisi: bio, GitHub, portofolio';
    })
    .catch((e) => tanganiGalat(e, salah));

  // Riwayat pemakaian KTM + tombol "Bukan saya".
  const BULAN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const kapan = (w: string) => `${+w.slice(8, 10)} ${BULAN[+w.slice(5, 7) - 1]}, ${w.slice(11, 16).replace(':', '.')}`;
  async function muatJejak() {
    try {
      const { jejak } = await api<{ jejak: { id: number; waktu: string; aksi: string; detail: string; disanggah: boolean }[] }>('/ktm/jejak');
      $('daftar-jejak').innerHTML = jejak.length
        ? jejak.map((j) => `<li class="${j.aksi === 'ditolak' ? 'ditolak' : ''}"><span class="isi-jejak"><b>${esc(j.detail)}</b><small>${kapan(j.waktu)}</small></span>${
            j.disanggah ? '<span class="disanggah">Disanggah</span>'
              : `<button class="bukan-saya" type="button" data-jejak="${j.id}">${j.aksi === 'ditolak' ? 'Blokir KTM' : 'Bukan saya'}</button>`}</li>`).join('')
        : '<li class="kosong">Belum ada catatan. Catatan muncul setelah KTM dipakai masuk, presensi, atau ditempel orang.</li>';
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }
  muatJejak();
  $('daftar-jejak').addEventListener('click', async (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-jejak]');
    if (!b) return;
    if (!confirm('KTM ini akan diblokir supaya salinannya tidak bisa dipakai lagi, dan catatan ini ditandai ke dosen. Lanjutkan?')) return;
    b.disabled = true;
    try {
      await api(`/ktm/jejak/${b.dataset.jejak}/bukan-saya`, {});
      $('banner-hilang').hidden = false;
      $('buka-hilang').closest('ul')!.hidden = true;
      muatJejak();
    } catch (e) {
      b.disabled = false;
      tanganiGalat(e, salah);
    }
  });

  $('buka-hapus').addEventListener('click', () => { $('form-hapus').hidden = !$('form-hapus').hidden; });
  $('form-hapus').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!confirm('Hapus akun dan semua data secara permanen? Ini tidak bisa dibatalkan.')) return;
    try {
      await api('/akun/hapus', { pin: ($('pin-hapus') as HTMLInputElement).value });
      sesi.hapus();
      location.href = '/';
    } catch (e) {
      tanganiGalat(e, salah);
    }
  });

  $('pin-tap').addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    try { await api('/keamanan', { pin_tap: el.checked }); }
    catch (err) { el.checked = !el.checked; tanganiGalat(err, salah); }
  });
  $('buka-pin').addEventListener('click', () => {
    const f = $('form-pin');
    f.hidden = !f.hidden;
    if (!f.hidden) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  $('form-pin').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    $('pin-ok').textContent = '';
    try {
      const r = await api<{ perangkat: string }>('/pin', { lama: ($('pin-lama') as HTMLInputElement).value, baru: ($('pin-baru') as HTMLInputElement).value });
      perangkat.simpan(r.perangkat);
      ($('form-pin') as HTMLFormElement).reset();
      $('pin-ok').textContent = 'PIN diganti';
    } catch (e) { tanganiGalat(e, salah); }
  });
  $('buka-hilang').addEventListener('click', () => {
    const f = $('form-hilang');
    f.hidden = !f.hidden;
    if (!f.hidden) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  async function aturHilang(hilang: boolean, pesan = '') {
    try {
      await api('/ktm/hilang', { hilang, pesan });
      location.reload();
    } catch (e) { tanganiGalat(e, salah); }
  }
  $('form-hilang').addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (confirm('Blokir KTM ini? Kartu tidak bisa dipakai masuk, presensi, atau check-in sampai kamu buka lagi.')) aturHilang(true, ($('pesan-hilang') as HTMLTextAreaElement).value);
  });
  $('ketemu').addEventListener('click', () => aturHilang(false));
  api<any>('/sertifikat').then((r) => ($('ringkas-sert').textContent = r.sertifikat.length ? `${r.sertifikat.length} sertifikat on-chain` : 'Belum ada, dapatkan lewat tap KTM di acara')).catch(() => {});
  $('buka-publik').addEventListener('click', () => {
    const f = $('form');
    f.hidden = !f.hidden;
    if (!f.hidden) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  Promise.all([api<any>('/beranda'), api<any>('/jadwal')])
    .then(([b, j]) => {
      const hadir = b.presensi.reduce((n: number, p: any) => n + p.hadir, 0);
      const total = b.presensi.reduce((n: number, p: any) => n + p.total, 0);
      $('a-hadir').textContent = total ? `${Math.round((hadir / total) * 100)}%` : '–';
      $('a-sks').textContent = String(j.kelas.reduce((n: number, k: any) => n + (k.sks || 0), 0));
      $('a-chain').textContent = String(b.onchain);
    })
    .catch(() => {});
  $('buka-ktm').addEventListener('click', () => ($('ktm-digital').hidden = !$('ktm-digital').hidden));

  $<HTMLFormElement>('form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    $('tersimpan').textContent = '';
    try {
      await api('/profil', {
        bio: $<HTMLTextAreaElement>('bio').value,
        github: $<HTMLInputElement>('github').value,
        portofolio: $<HTMLInputElement>('portofolio').value,
        publik: $<HTMLInputElement>('publik').checked,
      });
      $('tersimpan').textContent = 'Tersimpan';
    } catch (e) {
      tanganiGalat(e, salah);
    }
  });

  $('keluar').addEventListener('click', async () => {
    await api('/keluar', {}).catch(() => {});
    sesi.hapus();
    try { sessionStorage.clear(); } catch { /* abaikan */ }
    location.href = '/';
  });
</script>
