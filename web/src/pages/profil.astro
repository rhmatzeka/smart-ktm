---
import Dasar from '../layouts/Dasar.astro';
import Kartu from '../components/Kartu.astro';
import { ikon } from '../lib/ikon';
const panah = ikon('kembali', 'ikon panah');
---
<Dasar judul="Profil" nav="profil">
  <header class="kepala-chat">
    <div>
      <h1>Profil</h1>
      <p>Akun, KTM, dan data dari MyUnpam</p>
    </div>
  </header>

  <section class="isi-profil">
    <!-- Identitas -->
    <article class="identitas">
      <span class="foto-profil" id="foto">·</span>
      <div class="identitas-teks">
        <b id="nama">Memuat…</b>
        <span id="nim"></span>
        <span id="prodi"></span>
      </div>
    </article>
    <ul class="daftar-info">
      <li><Fragment set:html={ikon('nfc')} /><span>KTM fisik</span><b id="ktm-status">–</b></li>
      <li><Fragment set:html={ikon('sekolah')} /><span>Kampus</span><b>Universitas Pamulang</b></li>
    </ul>

    <!-- Aksi -->
    <p class="label-bagian">Akun</p>
    <ul class="daftar-aksi">
      <li><a href="/sinkron/"><Fragment set:html={ikon('kalender')} /><span><b>Sinkron jadwal MyUnpam</b><small>Ambil jadwal, presensi, dan foto terbaru</small></span><Fragment set:html={panah} /></a></li>
      <li><button type="button" id="buka-ktm"><Fragment set:html={ikon('kartu')} /><span><b>KTM digital</b><small>Tampilkan kartu di layar</small></span><Fragment set:html={panah} /></button></li>
      <li class="ktm-digital" id="ktm-digital" hidden><Kartu /></li>
      <li><a href="/verifikasi/"><Fragment set:html={ikon('rantai')} /><span><b>Cek bukti kehadiran</b><small>Lihat catatan presensi di blockchain</small></span><Fragment set:html={panah} /></a></li>
    </ul>

    <!-- Profil publik -->
    <p class="label-bagian">Profil publik, terlihat saat KTM-mu ditap orang lain</p>
    <form class="blok-form" id="form">
      <label for="bio">Bio singkat</label>
      <textarea id="bio" name="bio" rows="2" maxlength="160" placeholder="Contoh: Suka web3, IoT, dan AI agent"></textarea>
      <div class="dua-kolom">
        <div>
          <label for="github">GitHub</label>
          <input id="github" name="github" autocomplete="off" placeholder="username" />
        </div>
        <div>
          <label for="portofolio">Portofolio</label>
          <input id="portofolio" name="portofolio" placeholder="contoh.my.id" />
        </div>
      </div>
      <label class="saklar"><input type="checkbox" id="publik" name="publik" /><span>Tampilkan profil saat KTM ditap orang lain</span></label>
      <div class="baris-simpan">
        <span class="tersimpan" id="tersimpan" role="status"></span>
        <button class="tombol kecil-saja" type="submit">Simpan</button>
      </div>
    </form>

    <button class="keluar" id="keluar" type="button"><Fragment set:html={ikon('keluar')} /> Keluar dari perangkat ini</button>
    <p id="pesan" class="pesan-galat" role="alert" hidden></p>
  </section>
</Dasar>

<style is:global>
  body:has(.isi-profil) .halaman { background: var(--latar); }
  .kepala-chat { position: sticky; top: 0; z-index: 5; display: flex; gap: 12px; align-items: center; padding: 12px 16px; background: var(--putih); border-bottom: 1px solid var(--garis); }
  .kepala-chat h1 { font-size: 1.05rem; font-weight: 800; }
  .kepala-chat p { font-size: 0.78rem; color: var(--teks-2); }

  .isi-profil { flex: 1; padding: 14px 16px 100px; }
  .label-bagian { font-size: 0.78rem; font-weight: 700; color: var(--teks-2); margin: 18px 2px 8px; }

  .identitas { display: flex; gap: 12px; align-items: center; background: var(--putih); border: 1px solid var(--garis); border-radius: 16px 16px 0 0; padding: 14px; }
  .foto-profil { width: 56px; height: 66px; border-radius: 10px; overflow: hidden; flex: none; display: grid; place-items: center; font-weight: 800; font-size: 1.2rem; background: var(--biru-pudar); color: var(--biru); }
  .foto-profil img { width: 100%; height: 100%; object-fit: cover; }
  .identitas-teks { display: flex; flex-direction: column; min-width: 0; }
  .identitas-teks b { font-size: 1.05rem; font-weight: 800; }
  .identitas-teks span { font-size: 0.8rem; color: var(--teks-2); }

  .daftar-info, .daftar-aksi { list-style: none; margin: 0; padding: 0; background: var(--putih); border: 1px solid var(--garis); }
  .daftar-info { border-top: 0; border-radius: 0 0 16px 16px; }
  .daftar-aksi { border-radius: 16px; overflow: hidden; }
  .daftar-info li { display: flex; gap: 10px; align-items: center; padding: 10px 14px; font-size: 0.85rem; border-top: 1px solid #eef1f6; }
  .daftar-info li span { color: var(--teks-2); }
  .daftar-info li b { margin-left: auto; font-weight: 700; text-align: right; }
  .daftar-info .ikon, .daftar-aksi .ikon { width: 18px; height: 18px; color: var(--biru); flex: none; }
  .daftar-aksi li + li { border-top: 1px solid #eef1f6; }
  .daftar-aksi a, .daftar-aksi button {
    width: 100%; display: flex; gap: 12px; align-items: center; padding: 12px 14px; text-align: left;
    background: none; border: 0; color: var(--teks); text-decoration: none; font: inherit; cursor: pointer;
  }
  .daftar-aksi span { flex: 1; display: flex; flex-direction: column; }
  .daftar-aksi b { font-size: 0.9rem; font-weight: 700; }
  .daftar-aksi small { font-size: 0.75rem; color: var(--teks-2); }
  .daftar-aksi .panah { transform: rotate(180deg); color: var(--teks-2); width: 16px; height: 16px; }
  .ktm-digital { padding: 12px 14px; }

  .blok-form { background: var(--putih); border: 1px solid var(--garis); border-radius: 16px; padding: 4px 14px 14px; }
  .blok-form label { font-size: 0.8rem; margin: 10px 0 5px; }
  .blok-form textarea { min-height: 0; }
  .dua-kolom { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .saklar { display: flex; gap: 10px; align-items: center; font-weight: 500; margin-top: 12px; }
  .saklar input { width: 18px; min-height: 18px; height: 18px; accent-color: var(--biru); }
  .baris-simpan { display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 12px; }
  .tersimpan { color: var(--hijau); font-size: 0.8rem; font-weight: 700; }

  .keluar { margin-top: 18px; width: 100%; display: flex; gap: 8px; align-items: center; justify-content: center; padding: 12px; border-radius: 14px; border: 1px solid var(--garis); background: var(--putih); color: var(--merah); font: 700 0.88rem var(--font); cursor: pointer; }
  .keluar .ikon { width: 18px; height: 18px; }
  .pesan-galat { margin-top: 10px; padding: 10px 12px; border-radius: 12px; background: #fff1f2; color: #9f1239; font-size: 0.85rem; font-weight: 600; }
</style>

<script>
  import { api, sesi, tanganiGalat } from '../lib/api';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const salah = (t: string) => { $('pesan').textContent = t; $('pesan').hidden = !t; };

  api<any>('/saya')
    .then((s) => {
      if (s.foto) {
        const img = document.createElement('img');
        img.src = s.foto;
        img.alt = '';
        $('foto').replaceChildren(img);
      } else $('foto').textContent = s.nama.split(/\s+/).slice(0, 2).map((k: string) => k.charAt(0)).join('');
      $('nama').textContent = s.nama;
      $('nim').textContent = s.nim;
      $('prodi').textContent = [s.prodi || (s.peran === 'dosen' ? 'Dosen' : ''), s.semester && `Semester ${s.semester}`].filter(Boolean).join(' · ');
      $('ktm-status').textContent = s.ktm ? 'Tertaut' : 'Belum tertaut';
      const isi = (k: string, v: string) => (document.querySelector(`[data-isi=${k}]`)!.textContent = v);
      isi('nama', s.nama);
      isi('nim', s.nim);
      isi('prodi', s.prodi);
      $<HTMLTextAreaElement>('bio').value = s.bio;
      $<HTMLInputElement>('github').value = s.github;
      $<HTMLInputElement>('portofolio').value = s.portofolio;
      $<HTMLInputElement>('publik').checked = s.publik;
    })
    .catch((e) => tanganiGalat(e, salah));

  $('buka-ktm').addEventListener('click', () => ($('ktm-digital').hidden = !$('ktm-digital').hidden));

  $<HTMLFormElement>('form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    $('tersimpan').textContent = '';
    try {
      await api('/profil', {
        bio: $<HTMLTextAreaElement>('bio').value,
        github: $<HTMLInputElement>('github').value,
        portofolio: $<HTMLInputElement>('portofolio').value,
        publik: $<HTMLInputElement>('publik').checked,
      });
      $('tersimpan').textContent = 'Tersimpan';
    } catch (e) {
      tanganiGalat(e, salah);
    }
  });

  $('keluar').addEventListener('click', async () => {
    await api('/keluar', {}).catch(() => {});
    sesi.hapus();
    try { sessionStorage.clear(); } catch { /* abaikan */ }
    location.href = '/';
  });
</script>
