---
import Dasar from '../layouts/Dasar.astro';
import { ikon } from '../lib/ikon';
---
<Dasar judul="Cek bukti kehadiran">
  <header class="atas-putih">
    <a class="merek" href="/" style="text-decoration:none"><Fragment set:html={ikon('kartu')} /> Smart KTM</a>
    <h1 class="sapa-besar">Cek bukti kehadiran</h1>
    <p class="sapa-kecil">Pastikan catatan kehadiran asli dan sudah tercatat di blockchain.</p>
  </header>

  <section class="zona-biru">
    <form class="kartu" id="form">
      <label for="b" style="margin-top:0">Kode bukti</label>
      <input id="b" name="b" placeholder="64 karakter, boleh diawali 0x" autocomplete="off" required />
      <button class="tombol" type="submit" style="margin-top:14px">Cek bukti</button>
    </form>

    <article class="kartu hasil" id="hasil" hidden>
      <div class="vonis" id="vonis"></div>
      <ul class="rincian" id="rincian"></ul>
    </article>
    <p id="pesan" class="galat" role="alert" style="margin-top:12px"></p>
  </section>
</Dasar>

<style is:global>
  .hasil { margin-top: 14px; }
  .vonis { display: flex; gap: 12px; align-items: center; font-size: 1.15rem; font-weight: 800; margin-bottom: 12px; }
  .vonis .ikon-besar { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: var(--putih); flex: none; }
  .vonis.sah .ikon-besar { background: var(--hijau); }
  .vonis.lokal .ikon-besar { background: #f59e0b; }
  .rincian { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .rincian li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; background: var(--latar); border-radius: 12px; font-size: 0.88rem; }
  .rincian li span:first-child { color: var(--teks-2); }
  .rincian li span:last-child, .rincian li a { font-weight: 700; text-align: right; overflow-wrap: anywhere; }
  .rincian a { color: var(--biru); }
</style>

<script>
  import { api, esc } from '../lib/api';
  import { ikon } from '../lib/ikon';

  const $ = (id: string) => document.getElementById(id)!;
  const input = $('b') as HTMLInputElement;

  async function cek(kode: string) {
    $('pesan').textContent = '';
    $('hasil').hidden = true;
    try {
      const r = await api<any>(`/verifikasi/${encodeURIComponent(kode.trim())}`);
      const onchain = r.chain && r.chain.tercatat;
      const teks = onchain ? 'Asli dan tercatat di blockchain' : r.status === 'riwayat' ? 'Asli, dari riwayat sebelum blockchain aktif' : 'Asli, tapi belum tercatat di blockchain';
      $('vonis').className = `vonis ${onchain ? 'sah' : 'lokal'}`;
      $('vonis').innerHTML = `<span class="ikon-besar">${ikon(onchain ? 'perisai' : 'peringatan')}</span><span>${teks}</span>`;
      const baris: [string, string][] = [
        ['Mahasiswa', `${r.mahasiswa} (${r.nim})`],
        ['Mata kuliah', r.matkul],
        ['Pertemuan', String(r.pertemuan)],
        ['Waktu tap', `${r.waktu} WIB`],
      ];
      if (onchain) baris.push(['Waktu blok', new Date(r.chain.timestamp * 1000).toLocaleString('id-ID')]);
      const pendek = (h: string) => `${h.slice(0, 10)}…${h.slice(-6)}`;
      const alamat = r.kontrak ? (r.kontrak.match(/0x[0-9a-fA-F]{40}/) || [''])[0] : '';
      const tautan = (url: string | null, teks: string) => url ? `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(teks)} ↗</a>` : `<span>${esc(teks)}</span>`;
      $('rincian').innerHTML =
        baris.map(([k, v]) => `<li><span>${esc(k)}</span><span>${esc(v)}</span></li>`).join('') +
        (r.tx ? `<li><span>Transaksi</span>${tautan(r.link_tx, pendek(r.tx))}</li>` : '') +
        (alamat ? `<li><span>Kontrak</span>${tautan(r.kontrak.startsWith('http') ? r.kontrak : null, pendek(alamat))}</li>` : '') +
        `<li><span>Jaringan</span><span>${r.kontrak && r.kontrak.startsWith('http') ? 'Ethereum Sepolia (Etherscan)' : 'Blockchain lokal (belum publik)'}</span></li>`;
      $('hasil').hidden = false;
    } catch (e) {
      $('pesan').textContent = (e as Error).message;
    }
  }

  $('form').addEventListener('submit', (ev) => {
    ev.preventDefault();
    cek(input.value);
  });
  const awal = new URLSearchParams(location.search).get('b');
  if (awal) {
    input.value = awal;
    cek(awal);
  }
</script>
