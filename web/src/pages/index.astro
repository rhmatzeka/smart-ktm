---
import Dasar from '../layouts/Dasar.astro';
import Kartu from '../components/Kartu.astro';
---
<Dasar judul="Tap KTM">
  <header class="kepala">
    <p class="merek">Smart KTM</p>
    <h1>Tap KTM kamu, kuliahmu langsung kebuka.</h1>
  </header>

  <div class="kartu-wrap"><Kartu nama="KTM kamu" nim="Tempel di belakang HP" prodi="Universitas Pamulang" /></div>

  <!-- Lanjut sesi yang tersimpan -->
  <section id="lanjut" hidden>
    <a class="tombol" id="lanjut-ke" href="/beranda/">Lanjut sebagai <span id="lanjut-nama"></span></a>
    <button class="tautan" id="ganti-akun" type="button">Ganti akun</button>
  </section>

  <!-- Awal: tap atau NIM -->
  <section id="awal">
    <button class="tombol sinyal" id="mulai-tap" type="button">Tap KTM</button>
    <p class="redup kecil catatan" id="tanpa-nfc" hidden>
      Tap KTM hanya bisa di Chrome Android dengan NFC menyala. Di perangkat ini, masuk pakai NIM.
    </p>
    <button class="tombol garis" id="ke-nim" type="button">Masuk pakai NIM</button>
    <p class="redup kecil catatan">Aplikasi hanya membaca nomor seri kartu. Isi KTM, termasuk data parkir, tidak diubah.</p>
  </section>

  <!-- Menunggu kartu -->
  <section id="menunggu" hidden>
    <p class="status-besar">Tempelkan KTM ke belakang HP</p>
    <p class="redup">Tahan sebentar sampai HP bergetar.</p>
    <button class="tautan" id="batal-tap" type="button">Batal</button>
  </section>

  <!-- KTM terdaftar: PIN -->
  <form id="form-pin" hidden>
    <p class="status-besar">Halo, <span id="pin-nama"></span>.</p>
    <label for="pin">PIN 6 angka</label>
    <input id="pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
    <button class="tombol" type="submit">Masuk</button>
  </form>

  <!-- KTM baru: daftar -->
  <form id="form-daftar" hidden>
    <p class="status-besar">KTM ini belum terdaftar.</p>
    <p class="redup">Daftarkan sekali, setelah itu cukup tap. Kalau NIM kamu sudah ada di sistem, isi NIM dan PIN saja.</p>
    <label for="d-nim">NIM</label>
    <input id="d-nim" name="nim" inputmode="numeric" required />
    <label for="d-nama">Nama lengkap</label>
    <input id="d-nama" name="nama" autocomplete="name" />
    <label for="d-prodi">Program studi</label>
    <input id="d-prodi" name="prodi" value="Teknik Informatika" />
    <label for="d-pin">Buat PIN 6 angka</label>
    <input id="d-pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="new-password" required />
    <button class="tombol" type="submit">Daftarkan KTM</button>
  </form>

  <!-- Masuk pakai NIM -->
  <form id="form-nim" hidden>
    <label for="m-nim">NIM atau NIDN</label>
    <input id="m-nim" name="nim" inputmode="numeric" required />
    <label for="m-pin">PIN</label>
    <input id="m-pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
    <button class="tombol" type="submit">Masuk</button>
    <button class="tautan" id="kembali" type="button">Kembali</button>
  </form>

  <p id="pesan" class="galat" role="alert"></p>
</Dasar>

<style>
  .kepala { margin: 8px 0 24px; }
  .merek { font-family: var(--judul); font-weight: 700; color: var(--tinta-2); margin-bottom: 10px; }
  .kepala h1 { font-size: 2.35rem; max-width: 14ch; }
  .kartu-wrap { margin-bottom: 28px; }
  section, form { display: flex; flex-direction: column; gap: 12px; }
  form { gap: 0; }
  form .tombol { margin-top: 20px; }
  .catatan { text-align: center; }
  .status-besar { font-family: var(--judul); font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
  #pesan { margin-top: 16px; min-height: 1.5em; }
</style>

<script>
  import { api, sesi, tujuan, GalatApi } from '../lib/api';
  import { bacaKtm, nfcDidukung, pesanGalatNfc, type Berhenti } from '../lib/nfc';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const bagian = ['lanjut', 'awal', 'menunggu', 'form-pin', 'form-daftar', 'form-nim'];
  const kartu = document.querySelector('.ktm')!;
  const pesan = $('pesan');
  let uid = '';
  let berhenti: Berhenti | null = null;

  function tampil(id: string) {
    bagian.forEach((b) => ($(b).hidden = b !== id));
    kartu.classList.toggle('sinyal', id === 'menunggu');
    pesan.textContent = '';
    $(id).querySelector<HTMLInputElement>('input')?.focus();
  }
  const salah = (t: string) => (pesan.textContent = t);

  function selesaiMasuk(r: { token: string; peran: string }) {
    sesi.simpan(r.token);
    location.href = tujuan(r.peran);
  }

  async function kartuTerbaca(u: string) {
    berhenti?.();
    berhenti = null;
    uid = u;
    try {
      const r = await api<{ terdaftar: boolean; nama?: string }>('/ktm/cek', { uid });
      if (r.terdaftar) {
        $('pin-nama').textContent = r.nama ?? '';
        tampil('form-pin');
      } else {
        tampil('form-daftar');
      }
    } catch (e) {
      tampil('awal');
      salah((e as Error).message);
    }
  }

  $('mulai-tap').addEventListener('click', async () => {
    try {
      berhenti = await bacaKtm(kartuTerbaca, salah);
      tampil('menunggu');
    } catch (e) {
      salah(pesanGalatNfc(e));
    }
  });
  $('batal-tap').addEventListener('click', () => { berhenti?.(); tampil('awal'); });
  $('ke-nim').addEventListener('click', () => tampil('form-nim'));
  $('kembali').addEventListener('click', () => tampil('awal'));
  $('ganti-akun').addEventListener('click', () => { sesi.hapus(); tampil('awal'); });

  function kirim(form: HTMLFormElement, jalan: (d: Record<string, string>) => Promise<void>) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const tombol = form.querySelector('button[type=submit]') as HTMLButtonElement;
      tombol.disabled = true;
      try {
        await jalan(Object.fromEntries(new FormData(form)) as Record<string, string>);
      } catch (e) {
        salah((e as Error).message);
      } finally {
        tombol.disabled = false;
      }
    });
  }
  kirim($('form-pin'), async (d) => selesaiMasuk(await api('/masuk', { uid, pin: d.pin })));
  kirim($('form-daftar'), async (d) => selesaiMasuk(await api('/daftar', { uid, ...d })));
  kirim($('form-nim'), async (d) => selesaiMasuk(await api('/masuk', { nim: d.nim, pin: d.pin })));

  if (!nfcDidukung()) {
    $('mulai-tap').hidden = true;
    $('tanpa-nfc').hidden = false;
  }

  // Sudah pernah masuk di perangkat ini?
  if (sesi.ambil()) {
    api<{ nama: string; peran: string }>('/saya')
      .then((s) => {
        $('lanjut-nama').textContent = s.nama.split(' ')[0];
        ($('lanjut-ke') as HTMLAnchorElement).href = tujuan(s.peran);
        tampil('lanjut');
      })
      .catch((e) => { if (e instanceof GalatApi && e.status === 401) sesi.hapus(); });
  }
</script>
