---
import Dasar from '../layouts/Dasar.astro';
import { ikon } from '../lib/ikon';
---
<Dasar judul="Masuk">
  <header class="pita-masuk">
    <div class="pita-atas"><span>Universitas Pamulang</span><span>Smart KTM</span></div>
    <h1>Masuk</h1>
    <p>Tap KTM, atau pakai NIM dan PIN</p>
  </header>

  <section class="kartu-masuk">
    <!-- Sudah pernah masuk di perangkat ini -->
    <a class="lanjut" id="lanjut" href="/beranda/" hidden>
      <span class="lanjut-foto" id="lanjut-foto">·</span>
      <span class="lanjut-teks"><b>Lanjut sebagai <span id="lanjut-nama"></span></b><span>Atau tempel KTM untuk langsung masuk</span></span>
      <span class="lanjut-panah"><Fragment set:html={ikon('kembali')} /></span>
    </a>

    <!-- Tap KTM -->
    <div id="awal">
      <div class="tap-baris">
        <div class="ktm-mini" aria-hidden="true"><span class="chip-mini"></span><span class="gel-mini"><Fragment set:html={ikon('nfc')} /></span></div>
        <div class="tap-teks"><b>Tap KTM</b><span>Hanya nomor seri yang dibaca, data parkir di kartu aman.</span></div>
      </div>
      <button class="tombol" id="mulai-tap" type="button"><Fragment set:html={ikon('nfc')} /> Tap KTM</button>
      <div class="info-nfc" id="tanpa-nfc" hidden>
        <p id="tanpa-nfc-teks">Tap KTM hanya bisa di Chrome Android dengan NFC menyala. Di perangkat ini, masuk pakai NIM.</p>
        <a class="tombol garis-biru" id="ke-chrome" href="#" hidden>Buka di Chrome</a>
      </div>
    </div>

    <div id="menunggu" hidden>
      <div class="tap-baris">
        <span class="denyut" aria-hidden="true"></span>
        <div class="tap-teks"><b>Tempelkan KTM ke belakang HP</b><span>Tahan sebentar sampai HP bergetar.</span></div>
        <button class="tautan" id="batal-tap" type="button">Batal</button>
      </div>
    </div>

    <!-- KTM terdaftar: PIN -->
    <form id="form-pin" hidden>
      <p class="judul-blok">Halo, <span id="pin-nama"></span>. Masukkan PIN.</p>
      <label for="pin">PIN 6 angka</label>
      <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
      <button class="tombol" type="submit">Masuk</button>
      <button class="tautan" type="button" data-kembali>Bukan kamu? Kembali</button>
    </form>

    <!-- KTM baru: daftar -->
    <form id="form-daftar" hidden>
      <p class="judul-blok">✓ KTM terbaca. Daftar sekali saja.</p>
      <p class="redup kecil">Kalau NIM kamu sudah ada di sistem, isi NIM dan PIN saja.</p>
      <label for="d-nim">NIM</label>
      <input id="d-nim" name="nim" inputmode="numeric" autocomplete="username" required />
      <label for="d-nama">Nama lengkap</label>
      <input id="d-nama" name="nama" autocomplete="name" />
      <label for="d-prodi">Program studi</label>
      <input id="d-prodi" name="prodi" value="Teknik Informatika" />
      <label for="d-pin">Buat PIN 6 angka</label>
      <input id="d-pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="new-password" required />
      <button class="tombol" type="submit">Daftarkan KTM</button>
      <button class="tautan" type="button" data-kembali>Batal</button>
    </form>

    <div id="hilang" hidden>
      <p class="judul-blok">KTM ini dilaporkan hilang</p>
      <p class="redup kecil">Kartu milik <b id="hilang-nama"></b> sudah diblokir pemiliknya, jadi tidak bisa dipakai masuk.</p>
      <p class="pesan-penemu" id="hilang-pesan" hidden></p>
      <p class="redup kecil">Terima kasih sudah menemukannya. Tolong kembalikan ke pemilik atau titipkan ke BAAK.</p>
      <button class="tautan" type="button" data-kembali>Kembali</button>
    </div>

    <p id="pesan" class="pesan-galat" role="alert" hidden></p>

    <!-- Masuk pakai NIM: di kartu yang sama, dekat atas supaya tidak tertutup keyboard -->
    <form id="form-nim">
      <p class="atau">atau pakai NIM</p>
      <div class="dua-kolom">
        <div>
          <label for="m-nim">NIM atau NIDN</label>
          <input id="m-nim" name="nim" inputmode="numeric" autocomplete="username" required />
        </div>
        <div>
          <label for="m-pin">PIN</label>
          <input id="m-pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
        </div>
      </div>
      <button class="tombol garis-biru" type="submit">Masuk</button>
    </form>
  </section>
  <p class="catatan-kecil">Smart KTM tidak menulis apa pun ke kartu atau ke sistem kampus.</p>
</Dasar>

<style is:global>
  body:has(.kartu-masuk) .halaman { background: var(--latar); }
  .pita-masuk {
    position: relative; overflow: hidden; color: var(--putih); padding: 16px 18px 60px;
    border-radius: 0 0 26px 26px;
    background: linear-gradient(135deg, #3b7bf6, var(--biru) 60%, var(--biru-tua));
  }
  .pita-masuk::after {
    content: ''; position: absolute; inset: -60% -20%; pointer-events: none;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.16) 50%, transparent 58%);
  }
  .pita-masuk .pita-atas { display: flex; justify-content: space-between; font-size: 0.75rem; opacity: 0.85; position: relative; z-index: 1; }
  .pita-masuk h1 { font-size: 1.7rem; font-weight: 800; margin-top: 18px; position: relative; z-index: 1; }
  .pita-masuk p { font-size: 0.88rem; opacity: 0.9; position: relative; z-index: 1; }

  .kartu-masuk {
    position: relative; z-index: 2; margin: -42px 14px 0; padding: 14px;
    background: var(--putih); border-radius: 18px; box-shadow: 0 14px 30px -20px rgba(15, 54, 153, 0.5);
    scroll-margin: 12px;
  }
  .kartu-masuk .tombol { margin-top: 12px; }
  .kartu-masuk .tautan { display: block; margin: 6px auto 0; color: var(--teks-2); font-size: 0.85rem; }
  .judul-blok { font-weight: 800; font-size: 0.98rem; margin-bottom: 2px; }
  .kartu-masuk label { margin-top: 10px; font-size: 0.8rem; }
  .dua-kolom { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
  .atau { display: flex; align-items: center; gap: 10px; margin: 16px 0 2px; font-size: 0.75rem; color: var(--teks-2); }
  .atau::before, .atau::after { content: ''; flex: 1; height: 1px; background: var(--garis); }

  .tap-baris { display: flex; gap: 12px; align-items: center; }
  .tap-teks { flex: 1; min-width: 0; }
  .tap-teks b { display: block; font-size: 0.95rem; }
  .tap-teks span { font-size: 0.8rem; color: var(--teks-2); }
  .tap-baris .tautan { margin: 0 0 0 auto; }
  .ktm-mini { width: 64px; aspect-ratio: 1.586; border-radius: 8px; flex: none; position: relative; background: linear-gradient(135deg, #3b7bf6, var(--biru) 60%, var(--biru-tua)); }
  .chip-mini { position: absolute; left: 8px; top: 13px; width: 12px; height: 9px; border-radius: 2px; background: linear-gradient(135deg, #fde68a, #f59e0b); }
  .gel-mini { position: absolute; right: 5px; top: 4px; color: rgba(255, 255, 255, 0.9); }
  .gel-mini .ikon { width: 12px; height: 12px; }
  .denyut { width: 14px; height: 14px; border-radius: 50%; background: var(--biru); flex: none; margin: 0 6px; animation: denyut 1.4s ease-out infinite; }
  @keyframes denyut { 0% { box-shadow: 0 0 0 0 rgba(23, 71, 201, 0.45); } 100% { box-shadow: 0 0 0 14px rgba(23, 71, 201, 0); } }
  .info-nfc { margin-top: 10px; }
  .info-nfc p { font-size: 0.8rem; color: var(--teks-2); background: var(--latar); padding: 10px 12px; border-radius: 10px; }

  .lanjut { display: flex; gap: 12px; align-items: center; padding: 10px 12px; margin-bottom: 14px; background: var(--latar); color: var(--teks); border-radius: 14px; text-decoration: none; }
  .lanjut-foto { width: 40px; height: 40px; border-radius: 11px; overflow: hidden; flex: none; display: grid; place-items: center; font-weight: 800; background: var(--biru-pudar); color: var(--biru); }
  .lanjut-foto img { width: 100%; height: 100%; object-fit: cover; }
  .lanjut-teks { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .lanjut-teks b { font-size: 0.9rem; }
  .lanjut-teks > span { font-size: 0.75rem; color: var(--teks-2); }
  .lanjut-panah { transform: rotate(180deg); display: grid; color: var(--biru); }

  .pesan-penemu { margin-top: 8px; padding: 10px 12px; border-radius: 10px; background: #fef3c7; color: #92400e; font-size: 0.85rem; font-weight: 600; }
  .pesan-galat { margin-top: 10px; padding: 10px 12px; border-radius: 12px; background: #fff1f2; color: #9f1239; font-size: 0.85rem; font-weight: 600; }
  .catatan-kecil { text-align: center; font-size: 0.75rem; color: var(--teks-2); margin: 16px 16px 28px; }
</style>

<script>
  import { api, sesi, tujuan, GalatApi } from '../lib/api';
  import { bacaKtm, diAndroid, diAplikasi, diBrave, diIphone, nfcDidukung, pesanGalatNfc, tautanChrome, type Berhenti } from '../lib/nfc';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  // Blok yang bergantian di bagian atas; form NIM selalu ada.
  const bagian = ['awal', 'menunggu', 'form-pin', 'form-daftar', 'hilang'];
  let uid = '';
  let berhenti: Berhenti | null = null;

  function salah(t: string) {
    $('pesan').textContent = t;
    $('pesan').hidden = !t;
  }

  function tampil(id: string) {
    bagian.forEach((b) => ($(b).hidden = b !== id));
    $('form-nim').hidden = id === 'form-pin' || id === 'form-daftar' || id === 'hilang';
    salah('');
    const input = $(id).querySelector<HTMLInputElement>('input');
    if (input) setTimeout(() => input.focus(), 50);
  }

  function selesaiMasuk(r: { token: string; peran: string }) {
    sesi.simpan(r.token);
    location.href = tujuan(r.peran);
  }

  async function kartuTerbaca(u: string) {
    berhenti?.();
    berhenti = null;
    uid = u;
    try {
      const r = await api<{ terdaftar: boolean; nama?: string; peran?: string; milik_sesi: boolean; hilang?: boolean; pesan?: string }>('/ktm/cek', { uid });
      if (r.hilang) {
        $('hilang-nama').textContent = r.nama ?? '';
        $('hilang-pesan').textContent = r.pesan ? `Pesan dari pemilik: "${r.pesan}"` : '';
        $('hilang-pesan').hidden = !r.pesan;
        tampil('hilang');
        return;
      }
      // KTM pemilik sesi di HP ini: langsung buka beranda, tanpa PIN.
      if (r.milik_sesi) {
        location.href = tujuan(r.peran ?? 'mhs');
        return;
      }
      if (r.terdaftar) {
        $('pin-nama').textContent = r.nama ?? '';
        tampil('form-pin');
      } else {
        tampil('form-daftar');
      }
    } catch (e) {
      tampil('awal');
      salah((e as Error).message);
    }
  }

  async function mulaiBaca() {
    try {
      berhenti = await bacaKtm(kartuTerbaca, salah);
      tampil('menunggu');
    } catch (e) {
      salah(pesanGalatNfc(e));
    }
  }

  $('mulai-tap').addEventListener('click', mulaiBaca);
  $('batal-tap').addEventListener('click', () => { berhenti?.(); berhenti = null; tampil('awal'); });
  document.querySelectorAll('[data-kembali]').forEach((b) => b.addEventListener('click', () => tampil('awal')));

  // Kolom yang sedang diisi digeser ke area terlihat saat keyboard muncul.
  document.addEventListener('focusin', (e) => {
    const el = e.target as HTMLElement;
    if (el.matches('input')) setTimeout(() => el.closest('form')?.scrollIntoView({ block: 'start', behavior: 'smooth' }), 300);
  });

  function kirim(form: HTMLFormElement, jalan: (d: Record<string, string>) => Promise<void>) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const tombol = form.querySelector('button[type=submit]') as HTMLButtonElement;
      tombol.disabled = true;
      try {
        await jalan(Object.fromEntries(new FormData(form)) as Record<string, string>);
      } catch (e) {
        salah((e as Error).message);
      } finally {
        tombol.disabled = false;
      }
    });
  }
  kirim($('form-pin'), async (d) => selesaiMasuk(await api('/masuk', { uid, pin: d.pin })));
  kirim($('form-daftar'), async (d) => selesaiMasuk(await api('/daftar', { uid, ...d })));
  kirim($('form-nim'), async (d) => selesaiMasuk(await api('/masuk', { nim: d.nim, pin: d.pin })));

  if (!nfcDidukung()) {
    // Tanpa NFC, masuk pakai NIM jadi aksi utama.
    $('form-nim').querySelector('button[type=submit]')!.classList.remove('garis-biru');
    $('mulai-tap').hidden = true;
    $('tanpa-nfc').hidden = false;
    if (diIphone()) {
      $('tanpa-nfc-teks').textContent = 'iPhone belum bisa membaca KTM (chip MIFARE Classic), jadi masuk pakai NIM. Tips: Bagikan → Tambahkan ke Layar Utama supaya Smart KTM jadi ikon aplikasi.';
    }
    if (diAndroid()) {
      ($('ke-chrome') as HTMLAnchorElement).href = tautanChrome();
      $('ke-chrome').hidden = false;
      if (diBrave()) $('tanpa-nfc-teks').textContent = 'Brave tidak bisa membaca NFC dari web. Buka di Chrome untuk tap KTM, atau masuk pakai NIM di bawah.';
    }
  }

  // Sudah pernah masuk di perangkat ini?
  if (sesi.ambil()) {
    api<{ nama: string; peran: string; foto?: string }>('/saya')
      .then((s) => {
        $('lanjut-nama').textContent = s.nama.split(' ')[0];
        ($('lanjut') as HTMLAnchorElement).href = tujuan(s.peran);
        if (s.foto) {
          const img = document.createElement('img');
          img.src = s.foto;
          img.alt = '';
          $('lanjut-foto').replaceChildren(img);
        } else $('lanjut-foto').textContent = s.nama.charAt(0);
        $('lanjut').hidden = false;
      })
      .catch((e) => { if (e instanceof GalatApi && e.status === 401) sesi.hapus(); });
  }

  // Di aplikasi Android: langsung siap baca (termasuk tap yang membuka aplikasi).
  // Di Chrome: langsung siap baca kalau izin NFC sudah pernah diberikan.
  if (diAplikasi()) mulaiBaca();
  else if (nfcDidukung()) {
    navigator.permissions
      ?.query({ name: 'nfc' as PermissionName })
      .then((p) => { if (p.state === 'granted') mulaiBaca(); })
      .catch(() => {});
  }
</script>
