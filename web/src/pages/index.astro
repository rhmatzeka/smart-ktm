---
import Dasar from '../layouts/Dasar.astro';
import Kartu from '../components/Kartu.astro';
import { ikon } from '../lib/ikon';
---
<Dasar judul="Tap KTM">
  <header class="atas-putih">
    <p class="merek"><Fragment set:html={ikon('kartu')} /> Smart KTM</p>
    <h1 class="sapa-besar">Tap KTM kamu</h1>
    <p class="sapa-kecil">Jadwal, tugas, dan AI asisten langsung terbuka.</p>
  </header>

  <section class="zona-biru">
    <div class="kartu-wrap"><Kartu nama="KTM kamu" nim="Tempel di belakang HP" prodi="Universitas Pamulang" /></div>

    <!-- Lanjut sesi yang tersimpan -->
    <div class="langkah" id="lanjut" hidden>
      <a class="tombol kuning" id="lanjut-ke" href="/beranda/">Lanjut sebagai <span id="lanjut-nama"></span></a>
      <button class="tautan" id="ganti-akun" type="button">Ganti akun</button>
    </div>

    <!-- Awal -->
    <div class="langkah" id="awal">
      <button class="tombol kuning" id="mulai-tap" type="button"><Fragment set:html={ikon('nfc')} /> Tap KTM</button>
      <p class="catatan" id="tanpa-nfc" hidden>Tap KTM hanya bisa di Chrome Android dengan NFC menyala. Di perangkat ini, masuk pakai NIM.</p>
      <button class="tombol garis" id="ke-nim" type="button">Masuk pakai NIM</button>
      <p class="catatan"><Fragment set:html={ikon('perisai')} /> Hanya nomor seri kartu yang dibaca. Isi KTM, termasuk data parkir, tidak diubah.</p>
    </div>

    <!-- Menunggu kartu -->
    <div class="langkah" id="menunggu" hidden>
      <p class="status">Tempelkan KTM ke belakang HP</p>
      <p class="catatan">Tahan sebentar sampai HP bergetar.</p>
      <button class="tautan" id="batal-tap" type="button">Batal</button>
    </div>

    <!-- KTM terdaftar: PIN -->
    <form class="kartu form" id="form-pin" hidden>
      <p class="status-gelap">Halo, <span id="pin-nama"></span> 👋</p>
      <label for="pin">PIN 6 angka</label>
      <input id="pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
      <button class="tombol" type="submit">Masuk</button>
    </form>

    <!-- KTM baru: daftar -->
    <form class="kartu form" id="form-daftar" hidden>
      <p class="status-gelap">✓ KTM terbaca, tinggal daftar sekali</p>
      <p class="redup kecil">Kartu ini belum tertaut ke akun mana pun. Isi data di bawah, berikutnya cukup tap KTM lalu masukkan PIN. Kalau NIM kamu sudah ada di sistem, isi NIM dan PIN saja.</p>
      <label for="d-nim">NIM</label>
      <input id="d-nim" name="nim" inputmode="numeric" required />
      <label for="d-nama">Nama lengkap</label>
      <input id="d-nama" name="nama" autocomplete="name" />
      <label for="d-prodi">Program studi</label>
      <input id="d-prodi" name="prodi" value="Teknik Informatika" />
      <label for="d-pin">Buat PIN 6 angka</label>
      <input id="d-pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="new-password" required />
      <button class="tombol" type="submit">Daftarkan KTM</button>
    </form>

    <!-- Masuk pakai NIM -->
    <form class="kartu form" id="form-nim" hidden>
      <p class="status-gelap">Masuk pakai NIM</p>
      <label for="m-nim">NIM atau NIDN</label>
      <input id="m-nim" name="nim" inputmode="numeric" required />
      <label for="m-pin">PIN</label>
      <input id="m-pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
      <button class="tombol" type="submit">Masuk</button>
      <button class="tautan biru" id="kembali" type="button">Kembali</button>
    </form>

    <p id="pesan" class="galat pesan" role="alert"></p>
  </section>
</Dasar>

<style is:global>
  .kartu-wrap { margin: 4px 4px 22px; transform: perspective(800px) rotateX(6deg); }
  .langkah { display: flex; flex-direction: column; gap: 12px; align-items: stretch; }
  .catatan { display: flex; gap: 8px; justify-content: center; align-items: flex-start; text-align: center; font-size: 0.85rem; color: rgba(255, 255, 255, 0.8); }
  .catatan .ikon { width: 16px; height: 16px; margin-top: 2px; }
  .status { font-size: 1.35rem; font-weight: 800; text-align: center; }
  .status-gelap { font-size: 1.25rem; font-weight: 800; margin-bottom: 4px; }
  .form .tombol { margin-top: 18px; }
  .tautan.biru { color: var(--biru); display: block; margin: 8px auto 0; }
  .langkah .tautan { color: var(--putih); }
  .pesan { margin-top: 14px; text-align: center; min-height: 1.5em; }
</style>

<script>
  import { api, sesi, tujuan, GalatApi } from '../lib/api';
  import { bacaKtm, nfcDidukung, pesanGalatNfc, type Berhenti } from '../lib/nfc';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const bagian = ['lanjut', 'awal', 'menunggu', 'form-pin', 'form-daftar', 'form-nim'];
  const kartu = document.querySelector('.ktm')!;
  const pesan = $('pesan');
  let uid = '';
  let berhenti: Berhenti | null = null;

  function tampil(id: string) {
    bagian.forEach((b) => ($(b).hidden = b !== id));
    kartu.classList.toggle('sinyal', id === 'menunggu');
    pesan.textContent = '';
    $(id).querySelector<HTMLInputElement>('input')?.focus();
  }
  const salah = (t: string) => (pesan.textContent = t);

  function selesaiMasuk(r: { token: string; peran: string }) {
    sesi.simpan(r.token);
    location.href = tujuan(r.peran);
  }

  async function kartuTerbaca(u: string) {
    berhenti?.();
    berhenti = null;
    uid = u;
    try {
      const r = await api<{ terdaftar: boolean; nama?: string; peran?: string; milik_sesi: boolean }>('/ktm/cek', { uid });
      // KTM pemilik sesi di HP ini: langsung buka beranda, tanpa PIN.
      if (r.milik_sesi) {
        location.href = tujuan(r.peran ?? 'mhs');
        return;
      }
      if (r.terdaftar) {
        $('pin-nama').textContent = r.nama ?? '';
        tampil('form-pin');
      } else {
        tampil('form-daftar');
      }
    } catch (e) {
      tampil('awal');
      salah((e as Error).message);
    }
  }

  async function mulaiBaca() {
    try {
      berhenti = await bacaKtm(kartuTerbaca, salah);
      tampil('menunggu');
    } catch (e) {
      salah(pesanGalatNfc(e));
    }
  }
  $('mulai-tap').addEventListener('click', mulaiBaca);
  $('batal-tap').addEventListener('click', () => { berhenti?.(); berhenti = null; tampil(sesi.ambil() ? 'lanjut' : 'awal'); });
  $('ke-nim').addEventListener('click', () => tampil('form-nim'));
  $('kembali').addEventListener('click', () => tampil('awal'));
  $('ganti-akun').addEventListener('click', () => { sesi.hapus(); tampil('awal'); });

  function kirim(form: HTMLFormElement, jalan: (d: Record<string, string>) => Promise<void>) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const tombol = form.querySelector('button[type=submit]') as HTMLButtonElement;
      tombol.disabled = true;
      try {
        await jalan(Object.fromEntries(new FormData(form)) as Record<string, string>);
      } catch (e) {
        salah((e as Error).message);
      } finally {
        tombol.disabled = false;
      }
    });
  }
  kirim($('form-pin'), async (d) => selesaiMasuk(await api('/masuk', { uid, pin: d.pin })));
  kirim($('form-daftar'), async (d) => selesaiMasuk(await api('/daftar', { uid, ...d })));
  kirim($('form-nim'), async (d) => selesaiMasuk(await api('/masuk', { nim: d.nim, pin: d.pin })));

  if (!nfcDidukung()) {
    $('mulai-tap').hidden = true;
    $('tanpa-nfc').hidden = false;
  }

  if (sesi.ambil()) {
    api<{ nama: string; peran: string }>('/saya')
      .then((s) => {
        $('lanjut-nama').textContent = s.nama.split(' ')[0];
        ($('lanjut-ke') as HTMLAnchorElement).href = tujuan(s.peran);
        if (!berhenti) tampil('lanjut');
      })
      .catch((e) => { if (e instanceof GalatApi && e.status === 401) sesi.hapus(); });
  }

  // Izin NFC sudah pernah diberikan: langsung siap baca, cukup tempel KTM.
  if (nfcDidukung()) {
    navigator.permissions
      ?.query({ name: 'nfc' as PermissionName })
      .then((p) => { if (p.state === 'granted') mulaiBaca(); })
      .catch(() => {});
  }
</script>
