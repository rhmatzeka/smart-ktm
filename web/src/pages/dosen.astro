---
import Dasar from '../layouts/Dasar.astro';
---
<Dasar judul="Mesin absen" gelap>
  <!-- Pilih kelas -->
  <section id="pilih">
    <p class="redup-terang" id="nama-dosen"></p>
    <h1>Buka presensi</h1>
    <p class="redup-terang intro">Pilih kelas, lalu HP ini jadi mesin absen. Mahasiswa cukup menempelkan KTM.</p>
    <ul class="kelas" id="kelas"></ul>
    <button class="tautan terang" id="keluar" type="button">Keluar</button>
  </section>

  <!-- Mesin absen -->
  <section id="mesin" hidden>
    <header class="atas">
      <div>
        <h1 id="m-matkul"></h1>
        <p class="redup-terang" id="m-info"></p>
      </div>
      <p class="hitung"><strong id="m-hadir">0</strong><span id="m-total"></span></p>
    </header>

    <button class="tombol sinyal" id="mulai" type="button">Mulai terima tap KTM</button>

    <div class="layar" id="layar" data-keadaan="tunggu" aria-live="assertive">
      <div class="riak" aria-hidden="true"><span></span><span></span></div>
      <p class="layar-nama" id="l-nama">Tempelkan KTM</p>
      <p class="layar-ket" id="l-ket">ke belakang HP ini</p>
    </div>

    <h2>Sudah hadir</h2>
    <ul class="hadir" id="daftar"></ul>
    <p class="redup-terang kecil" id="chain-info"></p>

    <button class="tombol garis-terang" id="tutup" type="button">Tutup sesi</button>
    <button class="tautan terang" id="kembali" type="button">Kembali ke daftar kelas</button>
  </section>

  <p id="pesan" class="galat-terang" role="alert"></p>
</Dasar>

<style is:global>
  .redup-terang { color: #a9bad0; }
  .intro { margin: 8px 0 20px; }
  h1 { color: var(--kertas); }
  h2 { color: var(--kertas); }
  .kelas { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .kelas button {
    width: 100%; text-align: left; padding: 16px; border-radius: var(--r-kartu); cursor: pointer;
    background: #163a5f; color: var(--kertas); border: 2px solid transparent; font: 1rem var(--isi);
  }
  .kelas button:hover, .kelas button:focus-visible { border-color: var(--sinyal); }
  .kelas strong { font-family: var(--judul); font-size: 1.2rem; display: block; }
  .kelas .aktif { color: var(--sinyal); font-weight: 700; }
  .tautan.terang { color: #a9bad0; margin-top: 16px; }

  .atas { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 18px; }
  .atas h1 { font-size: 1.6rem; }
  .hitung { font-family: var(--judul); text-align: right; white-space: nowrap; }
  .hitung strong { font-size: 2.6rem; color: var(--sinyal); }
  .hitung span { color: #a9bad0; font-size: 1.1rem; }

  .layar {
    position: relative; overflow: hidden; margin: 16px 0 8px; min-height: 230px;
    border-radius: 24px; padding: 28px 20px;
    display: flex; flex-direction: column; justify-content: flex-end;
    background: #163a5f; transition: background 0.25s;
  }
  .layar-nama { font-family: var(--judul); font-weight: 800; font-size: 2.4rem; line-height: 1.05; color: var(--kertas); position: relative; }
  .layar-ket { font-size: 1.1rem; color: #cdd8e6; margin-top: 6px; position: relative; }
  .layar[data-keadaan='hadir'] { background: var(--hadir); }
  .layar[data-keadaan='sudah'] { background: #5b6f86; }
  .layar[data-keadaan='galat'] { background: var(--awas); }
  .riak { position: absolute; right: -40px; top: -40px; width: 220px; height: 220px; }
  .riak span { position: absolute; inset: 0; border-radius: 50%; border: 4px solid var(--sinyal); opacity: 0; }
  .layar[data-keadaan='tunggu'].hidup .riak span { animation: riak 2s ease-out infinite; }
  .layar[data-keadaan='tunggu'].hidup .riak span:nth-child(2) { animation-delay: 1s; }
  @keyframes riak { from { transform: scale(0.15); opacity: 0.9; } to { transform: scale(1); opacity: 0; } }

  .hadir { list-style: none; margin: 0; padding: 0; border-top: 2px solid #a9bad0; }
  .hadir li { display: flex; justify-content: space-between; gap: 10px; padding: 10px 0; border-bottom: 1px solid #2b4d72; }
  .hadir .jam { font-weight: 700; white-space: nowrap; text-align: right; }
  .hadir a { color: var(--sinyal); font-size: 0.85rem; }
  .hadir .menunggu { color: #a9bad0; font-size: 0.85rem; }
  .hadir .gagal { color: #f3a99b; font-size: 0.85rem; }
  .garis-terang { margin-top: 24px; background: transparent; color: var(--kertas); box-shadow: inset 0 0 0 2px #a9bad0; }
  .galat-terang { color: #f3a99b; font-weight: 700; margin-top: 12px; }
</style>

<script>
  import { api, esc, jam, sesi, tanganiGalat } from '../lib/api';
  import { bacaKtm, nfcDidukung, pesanGalatNfc, type Berhenti } from '../lib/nfc';

  const $ = (id: string) => document.getElementById(id)!;
  const salah = (t: string) => ($('pesan').textContent = t);
  let sesiId = 0;
  let berhenti: Berhenti | null = null;
  let pantau: number | undefined;
  let kembaliTunggu: number | undefined;

  function layar(keadaan: string, nama: string, ket: string) {
    const l = $('layar');
    l.dataset.keadaan = keadaan;
    $('l-nama').textContent = nama;
    $('l-ket').textContent = ket;
    clearTimeout(kembaliTunggu);
    if (keadaan !== 'tunggu') kembaliTunggu = window.setTimeout(() => layar('tunggu', 'Tempelkan KTM', 'ke belakang HP ini'), 4000);
  }

  async function muatKelas() {
    try {
      const r = await api<any>('/dosen/kelas');
      $('nama-dosen').textContent = r.nama;
      $('kelas').innerHTML = r.kelas
        .map((k: any) => `<li><button data-matkul="${k.id}">
          <strong>${esc(k.nama)}</strong>
          ${esc(k.hari)} ${esc(k.mulai.replace(':', '.'))}, ruang ${esc(k.ruang)}, ${k.peserta} mahasiswa
          ${k.sesi_aktif ? '<br><span class="aktif">Sesi sedang dibuka</span>' : ''}</button></li>`)
        .join('');
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  function statusChain(p: any) {
    if (p.link_tx) return `<a href="${esc(p.link_tx)}" target="_blank" rel="noopener">lihat di blockchain</a>`;
    if (p.tx) return `<a href="/verifikasi/?b=${esc(p.bukti)}">tercatat on-chain</a>`;
    if (p.status === 'menunggu') return '<span class="menunggu">mengirim ke blockchain…</span>';
    if (p.status === 'gagal') return '<span class="gagal">gagal ke blockchain</span>';
    return `<a href="/verifikasi/?b=${esc(p.bukti)}">cek bukti</a>`;
  }

  async function muatSesi() {
    try {
      const s = await api<any>(`/dosen/sesi/${sesiId}`);
      $('m-matkul').textContent = s.matkul;
      $('m-info').textContent = `Pertemuan ${s.pertemuan}, ruang ${s.ruang}`;
      $('m-hadir').textContent = String(s.hadir);
      $('m-total').textContent = ` / ${s.total}`;
      const hadir = s.peserta.filter((p: any) => p.waktu);
      $('daftar').innerHTML = hadir.length
        ? hadir.map((p: any) => `<li><span>${esc(p.nama)}<br>${statusChain(p)}</span><span class="jam">${esc(jam(p.waktu))}</span></li>`).join('')
        : '<li class="redup-terang">Belum ada yang tap.</li>';
      $('chain-info').textContent = s.chain
        ? 'Setiap kehadiran dikirim ke smart contract sebagai hash, jadi tidak bisa diubah diam-diam.'
        : 'Blockchain belum diatur di server: kehadiran hanya tersimpan lokal.';
      if (!s.terbuka) {
        berhenti?.();
        ($('mulai') as HTMLButtonElement).hidden = true;
        $('tutup').hidden = true;
        layar('sudah', 'Sesi ditutup', 'Tidak menerima tap lagi');
        clearTimeout(kembaliTunggu);
      }
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  async function tap(uid: string) {
    try {
      const r = await api<any>(`/dosen/sesi/${sesiId}/tap`, { uid });
      if (r.status === 'sudah') layar('sudah', r.nama, `Sudah tercatat jam ${jam(r.waktu)}`);
      else layar('hadir', r.nama, `Hadir ${jam(r.waktu)}, NIM ${r.nim}`);
      muatSesi();
    } catch (e) {
      navigator.vibrate?.([80, 60, 80]);
      layar('galat', 'Tidak tercatat', (e as Error).message);
    }
  }

  async function bukaMesin(matkul: number) {
    try {
      const r = await api<{ id: number }>('/dosen/sesi', { matkul_id: matkul });
      sesiId = r.id;
      $('pilih').hidden = true;
      $('mesin').hidden = false;
      ($('mulai') as HTMLButtonElement).hidden = false;
      $('tutup').hidden = false;
      layar('tunggu', 'Tempelkan KTM', 'ke belakang HP ini');
      await muatSesi();
      pantau = window.setInterval(muatSesi, 3000);
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  $('kelas').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-matkul]');
    if (b) bukaMesin(Number(b.dataset.matkul));
  });
  $('mulai').addEventListener('click', async () => {
    try {
      berhenti = await bacaKtm(tap, (t) => layar('galat', 'Coba lagi', t));
      $('mulai').hidden = true;
      $('layar').classList.add('hidup');
    } catch (e) {
      salah(pesanGalatNfc(e));
    }
  });
  $('tutup').addEventListener('click', async () => {
    if (!confirm('Tutup sesi presensi ini? Mahasiswa tidak bisa tap lagi.')) return;
    await api(`/dosen/sesi/${sesiId}/tutup`, {}).catch((e) => salah(e.message));
    muatSesi();
  });
  $('kembali').addEventListener('click', () => {
    berhenti?.();
    clearInterval(pantau);
    $('layar').classList.remove('hidup');
    $('mesin').hidden = true;
    $('pilih').hidden = false;
    muatKelas();
  });
  $('keluar').addEventListener('click', async () => {
    await api('/keluar', {}).catch(() => {});
    sesi.hapus();
    location.href = '/';
  });

  if (!nfcDidukung()) salah('Mesin absen butuh Chrome di Android dengan NFC menyala.');
  muatKelas();
</script>
