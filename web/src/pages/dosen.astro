---
import Dasar from '../layouts/Dasar.astro';
import { ikon } from '../lib/ikon';
---
<Dasar judul="Mesin absen">
  <!-- Pilih kelas -->
  <div class="tahap" id="pilih">
    <header class="atas-putih">
      <div class="baris-atas">
        <p class="merek"><Fragment set:html={ikon('kartu')} /> Smart KTM</p>
        <button class="ikon-keluar" id="keluar" type="button" aria-label="Keluar" title="Keluar"><Fragment set:html={ikon('keluar')} /></button>
      </div>
      <h1 class="sapa-besar">Mode dosen</h1>
      <p class="sapa-kecil" id="nama-dosen"></p>
    </header>
    <section class="zona-biru">
      <p class="kartu-judul terang"><span class="titik-ikon t-oranye"><Fragment set:html={ikon('kalender')} /></span>Pilih kelas untuk membuka presensi</p>
      <ul class="kelas-dosen" id="kelas"></ul>
    </section>
  </div>

  <!-- Mesin absen -->
  <div class="tahap" id="mesin" hidden>
    <header class="atas-putih">
      <div class="baris-atas">
        <button class="ikon-kembali" id="kembali" type="button" aria-label="Kembali ke daftar kelas"><Fragment set:html={ikon('kembali')} /></button>
        <p class="hitung"><b id="m-hadir">0</b><span id="m-total"></span> hadir</p>
      </div>
      <h1 class="judul-kelas" id="m-matkul"></h1>
      <p class="sapa-kecil" id="m-info"></p>
    </header>

    <section class="zona-biru">
      <div class="layar" id="layar" data-keadaan="tunggu" aria-live="assertive">
        <div class="riak-layar" aria-hidden="true"><span></span><span></span></div>
        <div class="layar-ikon" id="l-ikon"><Fragment set:html={ikon('nfc')} /></div>
        <p class="layar-nama" id="l-nama">Tempelkan KTM</p>
        <p class="layar-ket" id="l-ket">ke belakang HP ini</p>
      </div>
      <button class="tombol kuning" id="mulai" type="button"><Fragment set:html={ikon('nfc')} /> Mulai terima tap KTM</button>

      <article class="kartu daftar-hadir">
        <p class="kartu-judul"><span class="titik-ikon t-hijau"><Fragment set:html={ikon('centang')} /></span>Sudah hadir</p>
        <ul id="daftar"></ul>
        <p class="redup kecil" id="chain-info"></p>
      </article>

      <button class="tombol garis tutup" id="tutup" type="button">Tutup sesi</button>
    </section>
  </div>

  <p id="pesan" class="galat pesan-dosen" role="alert"></p>
</Dasar>

<style is:global>
  .tahap { display: flex; flex-direction: column; flex: 1; }
  .ikon-keluar, .ikon-kembali { width: 40px; height: 40px; border-radius: 12px; border: 0; display: grid; place-items: center; cursor: pointer; }
  .ikon-keluar { background: #ffe4e6; color: var(--merah); }
  .ikon-kembali { background: var(--biru-pudar); color: var(--biru); }
  .kelas-dosen { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .kelas-dosen button {
    width: 100%; display: flex; gap: 12px; align-items: center; text-align: left; cursor: pointer;
    background: var(--putih); color: var(--teks); border: 0; border-radius: var(--r); padding: 14px; box-shadow: var(--bayang);
  }
  .kelas-dosen b { display: block; font-size: 1rem; }
  .kelas-dosen .app-ikon { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--garis); }
  .kelas-dosen .redup { font-size: 0.82rem; }
  .kelas-dosen .aktif { display: inline-block; margin-top: 4px; font-size: 0.72rem; font-weight: 700; color: var(--hijau); background: #dcfce7; padding: 2px 8px; border-radius: 99px; }
  .hitung { font-weight: 600; color: var(--teks-2); }
  .hitung b { font-size: 1.8rem; color: var(--biru); }
  .judul-kelas { font-size: 1.6rem; font-weight: 800; margin-top: 14px; }

  .layar {
    position: relative; overflow: hidden; min-height: 250px; margin-bottom: 14px;
    border-radius: 26px; padding: 22px; background: var(--putih); color: var(--teks);
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    box-shadow: var(--bayang); transition: background 0.25s, color 0.25s;
  }
  .layar-ikon { width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center; background: var(--biru-pudar); color: var(--biru); position: relative; z-index: 1; }
  .layar-ikon .ikon { width: 40px; height: 40px; }
  .layar-ikon.berfoto { width: 96px; height: 116px; border-radius: 14px; overflow: hidden; border: 3px solid rgba(255, 255, 255, 0.9); }
  .layar-ikon.berfoto img { width: 100%; height: 100%; object-fit: cover; }
  .layar-nama { font-size: 1.9rem; font-weight: 800; margin-top: 14px; position: relative; z-index: 1; line-height: 1.1; }
  .layar-ket { color: var(--teks-2); margin-top: 6px; position: relative; z-index: 1; }
  .layar[data-keadaan='hadir'] { background: var(--hijau); color: var(--putih); }
  .layar[data-keadaan='sudah'] { background: var(--biru-pudar); }
  .layar[data-keadaan='galat'] { background: var(--merah); color: var(--putih); }
  .layar[data-keadaan='hadir'] .layar-ket, .layar[data-keadaan='galat'] .layar-ket { color: rgba(255, 255, 255, 0.9); }
  .layar[data-keadaan='hadir'] .layar-ikon, .layar[data-keadaan='galat'] .layar-ikon { background: rgba(255, 255, 255, 0.2); color: var(--putih); }
  .riak-layar { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .riak-layar span { position: absolute; width: 84px; height: 84px; border-radius: 50%; border: 3px solid var(--biru-muda); opacity: 0; top: calc(50% - 72px); }
  .layar.hidup[data-keadaan='tunggu'] .riak-layar span { animation: riak-dosen 2s ease-out infinite; }
  .layar.hidup[data-keadaan='tunggu'] .riak-layar span:nth-child(2) { animation-delay: 1s; }
  @keyframes riak-dosen { from { transform: scale(1); opacity: 0.8; } to { transform: scale(2.6); opacity: 0; } }

  .daftar-hadir { margin-top: 14px; }
  .daftar-hadir ul { list-style: none; margin: 0 0 10px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .daftar-hadir li { display: flex; gap: 10px; align-items: center; padding: 10px; border-radius: 14px; background: var(--latar); }
  .daftar-hadir .avatar { width: 38px; height: 38px; font-size: 0.95rem; box-shadow: none; }
  .daftar-hadir .isi { flex: 1; min-width: 0; }
  .daftar-hadir .isi b { display: block; font-size: 0.9rem; }
  .daftar-hadir .isi a, .daftar-hadir .isi span { font-size: 0.76rem; }
  .daftar-hadir a { color: var(--biru); font-weight: 700; }
  .daftar-hadir .menunggu { color: var(--teks-2); }
  .daftar-hadir .gagal { color: var(--merah); }
  .daftar-hadir .jam { font-weight: 800; font-size: 0.9rem; }
  .tutup { margin-top: 16px; }
  .pesan-dosen { padding: 0 20px; }
</style>

<script>
  import { api, esc, jam, sesi, tanganiGalat } from '../lib/api';
  import { ikon, ikonApp } from '../lib/ikon';
  import { bacaKtm, nfcDidukung, pesanGalatNfc, type Berhenti } from '../lib/nfc';

  const $ = (id: string) => document.getElementById(id)!;
  const salah = (t: string) => ($('pesan').textContent = t);
  const WARNA = ['biru', 'teal', 'oranye', 'hijau', 'ungu', 'merah'];
  let sesiId = 0;
  let berhenti: Berhenti | null = null;
  let pantau: number | undefined;
  let kembaliTunggu: number | undefined;

  function layar(keadaan: string, nama: string, ket: string, foto?: string | null) {
    $('layar').dataset.keadaan = keadaan;
    $('l-ikon').classList.toggle('berfoto', !!foto);
    $('l-ikon').innerHTML = foto ? `<img src="${esc(foto)}" alt="">` : ikon(keadaan === 'hadir' || keadaan === 'sudah' ? 'centang' : keadaan === 'galat' ? 'peringatan' : 'nfc');
    $('l-nama').textContent = nama;
    $('l-ket').textContent = ket;
    clearTimeout(kembaliTunggu);
    if (keadaan !== 'tunggu') kembaliTunggu = window.setTimeout(() => layar('tunggu', 'Tempelkan KTM', 'ke belakang HP ini'), 4000);
  }

  async function muatKelas() {
    try {
      const r = await api<any>('/dosen/kelas');
      $('nama-dosen').textContent = r.nama;
      $('kelas').innerHTML = r.kelas
        .map((k: any, i: number) => `<li><button data-matkul="${k.id}">${ikonApp('kalender', WARNA[i % WARNA.length])}
          <span><b>${esc(k.nama)}</b><span class="redup">${esc(k.hari)} ${esc(k.mulai.replace(':', '.'))} · ${esc(k.ruang)} · ${k.peserta} mahasiswa</span>
          ${k.sesi_aktif ? '<br><span class="aktif">Sesi sedang dibuka</span>' : ''}</span></button></li>`)
        .join('');
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  function statusChain(p: any) {
    if (p.link_tx) return `<a href="${esc(p.link_tx)}" target="_blank" rel="noopener">⛓ lihat di explorer</a>`;
    if (p.tx) return `<a href="/verifikasi/?b=${esc(p.bukti)}">⛓ tercatat on-chain</a>`;
    if (p.status === 'menunggu') return '<span class="menunggu">mengirim ke blockchain…</span>';
    if (p.status === 'gagal') return '<span class="gagal">gagal ke blockchain</span>';
    return `<a href="/verifikasi/?b=${esc(p.bukti)}">cek bukti</a>`;
  }

  async function muatSesi() {
    try {
      const s = await api<any>(`/dosen/sesi/${sesiId}`);
      $('m-matkul').textContent = s.matkul;
      $('m-info').textContent = `Pertemuan ${s.pertemuan} · ruang ${s.ruang}`;
      $('m-hadir').textContent = String(s.hadir);
      $('m-total').textContent = `/${s.total}`;
      const hadir = s.peserta.filter((p: any) => p.waktu);
      $('daftar').innerHTML = hadir.length
        ? hadir.map((p: any) => `<li><span class="avatar">${esc(p.nama.charAt(0))}</span><span class="isi"><b>${esc(p.nama)}</b>${statusChain(p)}</span><span class="jam">${esc(jam(p.waktu))}</span></li>`).join('')
        : '<li class="redup">Belum ada yang tap.</li>';
      $('chain-info').innerHTML = s.chain
        ? `Setiap kehadiran dikirim ke smart contract sebagai hash, jadi tidak bisa diubah diam-diam.${s.kontrak && s.kontrak.startsWith('http') ? ` <a href="${esc(s.kontrak)}" target="_blank" rel="noopener">Lihat kontrak di Etherscan</a>` : ''}`
        : 'Blockchain belum diatur di server: kehadiran hanya tersimpan lokal.';
      if (!s.terbuka) {
        berhenti?.();
        $('mulai').hidden = true;
        $('tutup').hidden = true;
        clearTimeout(kembaliTunggu);
        $('layar').dataset.keadaan = 'sudah';
        $('l-nama').textContent = 'Sesi ditutup';
        $('l-ket').textContent = 'Tidak menerima tap lagi';
      }
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  async function tap(uid: string) {
    try {
      const r = await api<any>(`/dosen/sesi/${sesiId}/tap`, { uid });
      if (r.status === 'sudah') layar('sudah', r.nama, `Sudah tercatat jam ${jam(r.waktu)}`, r.foto);
      else layar('hadir', r.nama, `Hadir ${jam(r.waktu)} · NIM ${r.nim}`, r.foto);
      muatSesi();
    } catch (e) {
      navigator.vibrate?.([80, 60, 80]);
      layar('galat', 'Tidak tercatat', (e as Error).message);
    }
  }

  async function bukaMesin(matkul: number) {
    try {
      const r = await api<{ id: number }>('/dosen/sesi', { matkul_id: matkul });
      sesiId = r.id;
      $('pilih').hidden = true;
      $('mesin').hidden = false;
      $('mulai').hidden = false;
      $('tutup').hidden = false;
      layar('tunggu', 'Tempelkan KTM', 'ke belakang HP ini');
      await muatSesi();
      pantau = window.setInterval(muatSesi, 3000);
    } catch (e) {
      tanganiGalat(e, salah);
    }
  }

  $('kelas').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-matkul]');
    if (b) bukaMesin(Number(b.dataset.matkul));
  });
  $('mulai').addEventListener('click', async () => {
    try {
      berhenti = await bacaKtm(tap, (t) => layar('galat', 'Coba lagi', t));
      $('mulai').hidden = true;
      $('layar').classList.add('hidup');
    } catch (e) {
      salah(pesanGalatNfc(e));
    }
  });
  $('tutup').addEventListener('click', async () => {
    if (!confirm('Tutup sesi presensi ini? Mahasiswa tidak bisa tap lagi.')) return;
    await api(`/dosen/sesi/${sesiId}/tutup`, {}).catch((e) => salah(e.message));
    muatSesi();
  });
  $('kembali').addEventListener('click', () => {
    berhenti?.();
    clearInterval(pantau);
    $('layar').classList.remove('hidup');
    $('mesin').hidden = true;
    $('pilih').hidden = false;
    muatKelas();
  });
  $('keluar').addEventListener('click', async () => {
    await api('/keluar', {}).catch(() => {});
    sesi.hapus();
    location.href = '/';
  });

  if (!nfcDidukung()) salah('Mesin absen butuh Chrome di Android dengan NFC menyala.');
  muatKelas();
</script>
