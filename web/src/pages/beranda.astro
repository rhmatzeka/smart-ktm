---
import Dasar from '../layouts/Dasar.astro';
import { ikon, ikonApp } from '../lib/ikon';
---
<Dasar judul="Beranda" nav="beranda">
  <header class="pita-ktm">
    <div class="pita-atas"><span>Universitas Pamulang</span><span>Kartu Tanda Mahasiswa</span></div>
    <a class="pita-id" href="/profil/" aria-label="Profil">
      <span class="pita-foto" id="pita-foto">·</span>
      <span class="pita-teks">
        <b id="pita-nama">Memuat…</b>
        <span id="pita-nim"></span>
        <span id="pita-prodi"></span>
      </span>
      <span class="pita-chip" aria-hidden="true"></span>
    </a>
  </header>
  <div class="atas-menu">
    <nav class="menu-cepat" aria-label="Menu cepat">
      <a href="/jadwal/"><Fragment set:html={ikonApp('kalender', 'biru')} /><span>Jadwal</span></a>
      <a href="#tugas"><Fragment set:html={ikonApp('tugas', 'teal')} /><span>Tugas</span></a>
      <a href="/tanya/"><Fragment set:html={ikonApp('kilau', 'oranye')} /><span>Tanya AI</span></a>
      <a href="/kenalan/"><Fragment set:html={ikonApp('nfc', 'hijau')} /><span>Kenalan</span></a>
    </nav>
  </div>

  <section class="zona-biru naik">
    <!-- Kelas berikutnya -->
    <article class="kartu hero">
      <div class="hero-atas">
        <span class="hero-label" id="hero-label">Kelas berikutnya</span>
        <span class="hitung-mundur" id="hero-pil" hidden></span>
      </div>
      <h2 class="hero-matkul" id="hero-matkul">Memuat…</h2>
      <div class="hero-info" id="hero-info"></div>
    </article>

    <!-- Jadwal -->
    <article class="kartu bagian" id="jadwal">
      <p class="kartu-judul"><span class="titik-ikon t-oranye"><Fragment set:html={ikon('kalender')} /></span><span id="judul-jadwal">Jadwal hari ini</span></p>
      <ol class="garis-waktu" id="daftar-jadwal"></ol>
      <a class="lihat-semua" href="/jadwal/">Lihat jadwal seminggu</a>
    </article>

    <!-- Angka ringkas -->
    <div class="statistik">
      <a class="stat" href="#kehadiran"><b id="s-hadir">–</b><span>Kehadiran</span></a>
      <a class="stat" href="#tugas"><b id="s-tugas">–</b><span>Tugas aktif</span></a>
      <a class="stat" href="/profil/"><b id="s-chain">–</b><span>On-chain</span></a>
    </div>

    <!-- AI -->
    <a class="kartu ai-strip" href="/tanya/">
      <span class="titik-ikon t-biru"><Fragment set:html={ikon('kilau')} /></span>
      <p id="ringkasan">Menyiapkan ringkasan…</p>
      <span class="panah"><Fragment set:html={ikon('chat')} /></span>
    </a>

    <!-- Tugas -->
    <article class="kartu bagian" id="tugas">
      <p class="kartu-judul"><span class="titik-ikon t-hijau"><Fragment set:html={ikon('tugas')} /></span>Tugas</p>
      <ul class="daftar-tugas" id="daftar-tugas"></ul>
      <button class="lihat-semua" id="semua-tugas" type="button" hidden></button>
    </article>

    <!-- Kehadiran -->
    <article class="kartu bagian" id="kehadiran">
      <p class="kartu-judul"><span class="titik-ikon t-ungu"><Fragment set:html={ikon('centang')} /></span>Kehadiran</p>
      <ul class="daftar-hadir" id="daftar-presensi"></ul>
      <p class="sumber-data" id="sumber-hadir"></p>
      <button class="lihat-semua" id="semua-hadir" type="button"></button>
    </article>

    <p id="pesan" class="galat" role="alert"></p>
  </section>
</Dasar>

<style is:global>
  /* Header pita KTM */
  .pita-ktm {
    position: relative; overflow: hidden; color: var(--putih); padding: 14px 16px 18px;
    border-radius: 0 0 24px 24px;
    background: linear-gradient(135deg, #3b7bf6, var(--biru) 60%, var(--biru-tua));
  }
  .pita-ktm::after {
    content: ''; position: absolute; inset: -60% -20%; pointer-events: none;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.16) 50%, transparent 58%);
  }
  .pita-atas { display: flex; justify-content: space-between; font-size: 0.75rem; opacity: 0.85; position: relative; z-index: 1; }
  .pita-id { display: flex; gap: 12px; align-items: center; margin-top: 12px; color: inherit; text-decoration: none; position: relative; z-index: 1; }
  .pita-foto {
    width: 60px; height: 72px; border-radius: 10px; flex: none; overflow: hidden;
    display: grid; place-items: center; font-weight: 800; font-size: 1.4rem;
    background: rgba(255, 255, 255, 0.18); border: 2px solid rgba(255, 255, 255, 0.85);
  }
  .pita-foto img { width: 100%; height: 100%; object-fit: cover; }
  .pita-teks { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .pita-teks b { font-size: 1.15rem; font-weight: 800; line-height: 1.2; }
  .pita-teks span { font-size: 0.8rem; opacity: 0.9; }
  .pita-chip { width: 34px; height: 26px; border-radius: 6px; flex: none; align-self: flex-start; background: linear-gradient(135deg, #fde68a, #f59e0b); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12); }
  .atas-menu { padding: 0 16px; position: relative; z-index: 2; }
  /* Menu cepat: ikon garis biru, dipisah garis tipis (gaya aplikasi bank) */
  .menu-cepat {
    display: grid; grid-template-columns: repeat(4, 1fr);
    margin-top: 16px; padding: 11px 0; background: var(--putih);
    border: 1px solid var(--garis); border-radius: 18px;
    box-shadow: 0 14px 30px -20px rgba(15, 54, 153, 0.45);
    position: relative; z-index: 2;
  }
  .menu-cepat a { display: flex; flex-direction: column; align-items: center; gap: 5px; text-decoration: none; font-size: 0.75rem; font-weight: 700; color: var(--teks); }
  .menu-cepat a + a { border-left: 1px solid #eef1f6; }
  .menu-cepat a:active .app-ikon { transform: scale(0.92); }

  .bagian { margin-top: 10px; }

  /* Kartu utama: kelas berikutnya */
  .hero { padding: 14px; }
  .hero-atas { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .hero-label { font-size: 0.8rem; font-weight: 700; color: var(--biru); }
  .hitung-mundur { font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 99px; background: var(--kuning); color: #1f2a44; white-space: nowrap; }
  .hitung-mundur.hijau { background: #dcfce7; color: var(--hijau); }
  .hero-matkul { font-size: 1.25rem; font-weight: 800; margin: 6px 0 10px; }
  .hero-info { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; border-radius: 8px; background: var(--latar); font-size: 0.78rem; font-weight: 600; color: var(--teks-2); }
  .chip .ikon { width: 15px; height: 15px; color: var(--biru); }

  /* Garis waktu jadwal */
  .garis-waktu { list-style: none; margin: 0; padding: 0; }
  .garis-waktu li { display: grid; grid-template-columns: 52px 14px 1fr; gap: 10px; align-items: start; padding-bottom: 14px; position: relative; }
  .garis-waktu li:last-child { padding-bottom: 0; }
  .garis-waktu .jam-mulai { font-weight: 800; font-size: 0.9rem; padding-top: 1px; }
  .garis-waktu .titik { width: 12px; height: 12px; border-radius: 50%; margin-top: 4px; background: var(--biru-pudar); border: 2px solid var(--biru-muda); position: relative; }
  .garis-waktu li:not(:last-child) .titik::after { content: ''; position: absolute; left: 3px; top: 12px; width: 2px; height: 34px; background: var(--garis); }
  .garis-waktu li.berlangsung .titik { background: var(--hijau); border-color: var(--hijau); }
  .garis-waktu li.selesai { opacity: 0.5; }
  .garis-waktu b { display: block; font-size: 0.92rem; }
  .garis-waktu span.ket { font-size: 0.8rem; color: var(--teks-2); }
  .kosong { color: var(--teks-2); font-size: 0.9rem; }

  /* Angka ringkas */
  .statistik { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
  .stat {
    display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 6px; text-decoration: none;
    border-radius: 18px; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.22); color: var(--putih);
  }
  .stat b { font-size: 1.25rem; font-weight: 800; line-height: 1.1; }
  .stat span { font-size: 0.75rem; opacity: 0.85; }

  /* Ringkasan AI satu baris */
  .ai-strip { display: flex; gap: 10px; align-items: center; margin-top: 10px; text-decoration: none; padding: 12px; }
  .ai-strip p { flex: 1; font-size: 0.88rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .panah { width: 32px; height: 32px; border-radius: 10px; background: var(--biru); color: var(--putih); display: grid; place-items: center; flex: none; }
  .panah .ikon { width: 18px; height: 18px; }

  /* Tugas */
  .daftar-tugas, .daftar-hadir { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .daftar-tugas li { display: flex; gap: 12px; align-items: center; }
  .tanda { width: 6px; align-self: stretch; border-radius: 3px; flex: none; }
  .tanda.merah { background: var(--merah); } .tanda.kuning { background: #f59e0b; } .tanda.biasa { background: var(--biru-muda); }
  .daftar-tugas .isi, .daftar-hadir .isi { flex: 1; min-width: 0; }
  .daftar-tugas b, .daftar-hadir b { display: block; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .daftar-tugas .ke-mentari { color: inherit; text-decoration: none; }
  .daftar-tugas .ke-mentari b { text-decoration: underline; text-decoration-color: var(--garis, #d6dbe6); text-underline-offset: 3px; }
  .daftar-tugas .ket, .daftar-hadir .ket { font-size: 0.78rem; color: var(--teks-2); }
  .sisa { font-size: 0.78rem; font-weight: 800; white-space: nowrap; }
  .sisa.merah { color: var(--merah); } .sisa.kuning { color: #b45309; } .sisa.biasa { color: var(--biru); }
  .tombol-kumpul { border: 1.5px solid var(--garis); background: var(--putih); color: var(--hijau); width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; cursor: pointer; flex: none; }
  .tombol-kumpul .ikon { width: 18px; height: 18px; }

  /* Kehadiran */
  .daftar-hadir li.kosong { display: block; }
  .baris-hadir {
    width: 100%; display: flex; gap: 10px; align-items: center; text-align: left; cursor: pointer;
    background: none; border: 0; padding: 4px 0; font: inherit; color: inherit;
  }
  .panah-kecil { display: grid; place-items: center; color: var(--teks-2); transform: rotate(-90deg); transition: transform 0.2s; }
  .panah-kecil .ikon { width: 16px; height: 16px; }
  .baris-hadir[aria-expanded='true'] .panah-kecil { transform: rotate(90deg); }
  .rincian-hadir { margin: 8px 0 6px; padding: 12px; border-radius: 14px; background: var(--latar); }
  .ringkas-hadir { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; font-size: 0.75rem; color: var(--teks-2); margin-bottom: 10px; }
  .tanda-k { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-left: 4px; }
  .tanda-k.hadir { background: var(--hijau); } .tanda-k.terlewat { background: var(--merah); }
  .tanda-k.minggu_ini { background: #f59e0b; } .tanda-k.nanti { background: #cbd5e1; }
  .daftar-pertemuan { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .daftar-pertemuan li { display: flex; gap: 10px; align-items: center; background: var(--putih); border-radius: 12px; padding: 8px 10px; }
  .daftar-pertemuan .nomor { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; font-weight: 800; font-size: 0.8rem; flex: none; background: #e2e8f0; color: var(--teks-2); }
  .daftar-pertemuan li.hadir .nomor { background: #dcfce7; color: var(--hijau); }
  .daftar-pertemuan li.terlewat .nomor, .daftar-pertemuan li.absen .nomor { background: #ffe4e6; color: var(--merah); }
  .daftar-pertemuan li.minggu_ini .nomor { background: #fef3c7; color: #b45309; }
  .daftar-pertemuan li.nanti { opacity: 0.6; }
  .daftar-pertemuan b { font-size: 0.82rem; white-space: normal; }
  .status-k { font-size: 0.75rem; font-weight: 700; text-align: right; white-space: nowrap; display: flex; flex-direction: column; }
  .status-k small { font-weight: 500; color: var(--teks-2); }
  .daftar-pertemuan li.hadir .status-k { color: var(--hijau); }
  .daftar-pertemuan li.terlewat .status-k, .daftar-pertemuan li.absen .status-k { color: var(--merah); }
  .daftar-pertemuan li.minggu_ini .status-k { color: #b45309; }
  .status-k a { color: var(--biru); }
  .judul-tap { font-size: 0.8rem; font-weight: 700; margin: 12px 0 6px; }
  .batang { height: 6px; border-radius: 3px; background: var(--garis); margin-top: 5px; overflow: hidden; }
  .batang i { display: block; height: 100%; border-radius: 3px; background: var(--hijau); }
  .batang.awas i { background: var(--merah); }
  .skor { font-weight: 800; font-size: 0.85rem; white-space: nowrap; }
  .awas-teks { color: var(--merah); font-weight: 700; }
  .bisa-teks { color: #b45309; font-weight: 700; }
  .sumber-data { font-size: 0.75rem; color: var(--teks-2); margin-top: 8px; }
  a.lihat-semua { display: inline-block; text-decoration: none; }
  .lihat-semua { margin-top: 12px; border: 0; background: none; color: var(--biru); font: 700 0.85rem var(--font); cursor: pointer; padding: 4px 0; }
  #pesan { margin-top: 12px; }
</style>

<script>
  import { api, esc, tanganiGalat } from '../lib/api';
  import { jadwalkanNotif } from '../lib/notif';
  import { ikon } from '../lib/ikon';

  const $ = (id: string) => document.getElementById(id)!;
  const titik = (j: string) => j.replace(':', '.');
  const durasi = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} jam${m % 60 ? ` ${m % 60} mnt` : ''}` : `${m} menit`);
  let semuaTugas = false;
  const terbuka = new Set<number>();
  const rincian = new Map<number, string>();
  const BLN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const tgl = (t: string) => `${+t.slice(8, 10)} ${BLN[+t.slice(5, 7) - 1]}`;
  const KEADAAN: Record<string, string> = { hadir: 'Hadir', absen: 'Absen', terlewat: 'Belum presensi', minggu_ini: 'Minggu ini', nanti: 'Belum mulai' };

  function htmlRincian(d: any) {
    if (!d.pertemuan.length && !d.tap.length) return '<p class="kosong">Presensi mata kuliah ini belum dibuka di MyUnpam.</p>';
    const hitung = (k: string) => d.pertemuan.filter((p: any) => p.keadaan === k).length;
    const ringkas = `<p class="ringkas-hadir"><span class="tanda-k hadir"></span>${hitung('hadir')} hadir
      <span class="tanda-k terlewat"></span>${hitung('terlewat') + hitung('absen')} tidak hadir
      <span class="tanda-k minggu_ini"></span>${hitung('minggu_ini')} minggu ini
      <span class="tanda-k nanti"></span>${hitung('nanti')} belum mulai</p>`;
    const baris = d.pertemuan.map((p: any) => `<li class="${p.keadaan}"><span class="nomor">${p.ke}</span>
      <span class="isi"><b>Pertemuan ${p.ke}</b><span class="ket">${tgl(p.mulai)}–${tgl(p.akhir)}${p.jenis ? ` · ${esc(p.jenis)}` : ''}</span></span>
      <span class="status-k">${KEADAAN[p.keadaan]}${p.keadaan === 'hadir' && p.waktu ? `<small>${tgl(p.waktu)} ${p.waktu.slice(11, 16)}</small>` : ''}</span></li>`).join('');
    const tap = d.tap.length
      ? `<p class="judul-tap">Tap KTM di Smart KTM</p><ul class="daftar-pertemuan">${d.tap.map((t: any) => `<li class="hadir"><span class="nomor">${t.pertemuan}</span>
          <span class="isi"><b>Pertemuan ${t.pertemuan}</b><span class="ket">${esc(t.waktu)} WIB</span></span>
          <span class="status-k">${t.link_tx ? `<a href="${esc(t.link_tx)}" target="_blank" rel="noopener">on-chain</a>` : `<a href="/verifikasi/?b=${esc(t.bukti)}">bukti</a>`}</span></li>`).join('')}</ul>`
      : '';
    return ringkas + (baris ? `<ul class="daftar-pertemuan">${baris}</ul>` : '') + tap;
  }

  async function bukaRincian(id: number) {
    const el = document.getElementById(`rincian-${id}`);
    if (!el) return;
    if (!rincian.has(id)) el.innerHTML = '<p class="kosong">Memuat pertemuan…</p>';
    try {
      const html = htmlRincian(await api(`/kehadiran/${id}`));
      rincian.set(id, html);
      el.innerHTML = html;
    } catch (e) {
      el.innerHTML = `<p class="kosong">${esc((e as Error).message)}</p>`;
    }
  }
  let semuaHadir = false;
  let data: any = null;

  function hero(b: any) {
    const pil = $('hero-pil');
    pil.hidden = true;
    pil.className = 'hitung-mundur';
    let k: any = null;
    if (b.momen === 'kelas') {
      k = b.kelas_berlangsung;
      $('hero-label').textContent = 'Sedang berlangsung';
      pil.textContent = `selesai ${durasi(k.menit_tersisa)} lagi`;
      pil.classList.add('hijau');
      pil.hidden = false;
    } else if (b.momen === 'sebelum') {
      k = b.kelas_berikut;
      $('hero-label').textContent = 'Kelas berikutnya';
      pil.textContent = k.menit_lagi <= 180 ? `${durasi(k.menit_lagi)} lagi` : `jam ${titik(k.mulai)}`;
      pil.hidden = false;
    } else if (b.momen === 'malam' && b.jadwal_besok.length) {
      k = b.jadwal_besok[0];
      $('hero-label').textContent = 'Kelas pertama besok';
      pil.textContent = `besok ${titik(k.mulai)}`;
      pil.hidden = false;
    }
    if (!k && !b.presensi.length) {
      $('hero-label').textContent = 'Jadwal belum ada';
      $('hero-matkul').textContent = 'Sinkronkan jadwal dari MyUnpam';
      $('hero-info').innerHTML = '<a class="tombol kecil-saja" href="/sinkron/">Sinkron sekarang</a>';
      return;
    }
    if (!k) {
      $('hero-label').textContent = b.momen === 'setelah' ? 'Kelas hari ini selesai' : 'Hari ini';
      $('hero-matkul').textContent = b.momen === 'setelah' ? 'Waktunya istirahat atau cicil tugas' : 'Tidak ada kelas';
      $('hero-info').innerHTML = '';
      return;
    }
    $('hero-matkul').textContent = k.nama;
    $('hero-info').innerHTML = [
      `<span class="chip">${ikon('jam')}${titik(k.mulai)}–${titik(k.selesai)}</span>`,
      `<span class="chip">${ikon('lokasi')}${esc(k.ruang)}</span>`,
      `<span class="chip">${ikon('profil')}${esc(k.dosen)}</span>`,
    ].join('');
  }

  function render(b: any) {
    data = b;
    hero(b);

    const malam = b.momen === 'malam';
    const kelas: any[] = malam ? b.jadwal_besok : b.jadwal_hari_ini;
    $('judul-jadwal').textContent = malam ? 'Jadwal besok' : 'Jadwal hari ini';
    $('daftar-jadwal').innerHTML = kelas.length
      ? kelas.map((k) => `<li class="${malam ? '' : esc(k.status)}"><span class="jam-mulai">${titik(k.mulai)}</span><span class="titik"></span>
          <span><b>${esc(k.nama)}</b><span class="ket">${titik(k.mulai)}–${titik(k.selesai)} · ${esc(k.ruang)}</span></span></li>`).join('')
      : '<li class="kosong">Tidak ada kelas.</li>';

    const hadir = b.presensi.reduce((s: number, p: any) => s + p.hadir, 0);
    const total = b.presensi.reduce((s: number, p: any) => s + p.total, 0);
    $('s-hadir').textContent = total ? `${Math.round((hadir / total) * 100)}%` : '–';
    $('s-tugas').textContent = String(b.tugas.length);
    $('s-chain').textContent = String(b.onchain);
    $('ringkasan').textContent = b.ringkasan;

    const tugas = semuaTugas ? b.tugas : b.tugas.slice(0, 3);
    $('daftar-tugas').innerHTML = tugas.length
      ? tugas.map((t: any) => `<li><span class="tanda ${t.tingkat}"></span><span class="isi">${t.url ? `<a class="ke-mentari" href="${esc(t.url)}" target="_blank" rel="noopener"><b>${esc(t.judul)}</b></a>` : `<b>${esc(t.judul)}</b>`}<span class="ket">${t.jenis && t.jenis !== 'Tugas' ? `${esc(t.jenis)} Mentari, ` : t.url ? 'Mentari, ' : ''}${esc(t.matkul)}</span></span>
          <span class="sisa ${t.tingkat}">${esc(t.sisa)}</span>
          <button class="tombol-kumpul" data-tugas="${t.id}" aria-label="Tandai ${esc(t.judul)} sudah dikumpulkan" title="Sudah dikumpulkan">${ikon('centang')}</button></li>`).join('')
      : '<li class="kosong">Belum ada tugas. Sinkron MyUnpam di aplikasi Android ikut mengambil tugas Mentari, atau bilang ke Tanya AI, misalnya "ada tugas MPI bikin proposal, deadline Jumat".</li>';
    $('semua-tugas').hidden = b.tugas.length <= 3;
    $('semua-tugas').textContent = semuaTugas ? 'Tampilkan lebih sedikit' : `Lihat semua (${b.tugas.length})`;

    // Default hanya matkul yang perlu diperhatikan: terlewat, masih bisa presensi, atau mendekati batas.
    const waspada = b.presensi.filter((p: any) => p.status !== 'aman' || p.belum_presensi?.length || p.bisa_presensi?.length);
    const tampil = semuaHadir ? b.presensi : waspada;
    $('daftar-presensi').innerHTML = tampil.length
      ? tampil.map((p: any) => {
          const pct = p.total ? Math.round((p.hadir / p.total) * 100) : 100;
          const bagian: string[] = [];
          if (p.belum_presensi?.length) bagian.push(`<span class="awas-teks">belum presensi: pertemuan ${p.belum_presensi.join(', ')}</span>`);
          const absenLain = p.absen - (p.belum_presensi?.length || 0);
          if (absenLain > 0) bagian.push(`<span class="${p.status === 'aman' ? 'bisa-teks' : 'awas-teks'}">tercatat absen ${absenLain}× di MyUnpam</span>`);
          if (p.bisa_presensi?.length) bagian.push(`<span class="bisa-teks">minggu ini: pertemuan ${p.bisa_presensi.join(', ')} belum presensi</span>`);
          if (!bagian.length) bagian.push(p.absen ? `<span class="${p.status === 'aman' ? '' : 'awas-teks'}">absen ${p.absen}× dari batas ${p.batas}</span>` : p.sumber === 'myunpam' || p.total ? 'semua pertemuan hadir' : 'presensi belum dibuka di MyUnpam');
          const ket = bagian.join('<br>');
          const buka = terbuka.has(p.id);
          return `<li class="matkul-hadir"><button class="baris-hadir" type="button" data-matkul="${p.id}" aria-expanded="${buka}">
            <span class="isi"><b>${esc(p.matkul)}</b><span class="ket">${ket}</span>
            <div class="batang ${p.status === 'aman' ? '' : 'awas'}"><i style="width:${pct}%"></i></div></span>
            <span class="skor">${p.hadir}/${p.total}</span><span class="panah-kecil">${ikon('kembali')}</span></button>
            <div class="rincian-hadir" id="rincian-${p.id}" ${buka ? '' : 'hidden'}>${rincian.get(p.id) ?? ''}</div></li>`;
        }).join('')
      : `<li class="kosong">${total ? 'Semua mata kuliah aman 👍' : 'Belum ada pertemuan tercatat. Kehadiran dihitung dari tap KTM di HP dosen.'}</li>`;
    $('sumber-hadir').textContent = b.presensi.some((p: any) => p.sumber === 'myunpam') ? 'Data presensi dari MyUnpam (sinkron terakhir).' : '';
    $('semua-hadir').textContent = semuaHadir ? 'Tampilkan yang perlu diwaspadai saja' : `Lihat semua mata kuliah (${b.presensi.length})`;
  }

  async function muat() {
    try {
      render(await api('/beranda'));
      jadwalkanNotif();
    } catch (e) {
      tanganiGalat(e, (t) => ($('pesan').textContent = t));
    }
  }

  $('daftar-presensi').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.baris-hadir');
    if (!b) return;
    const id = Number(b.dataset.matkul);
    const el = document.getElementById(`rincian-${id}`)!;
    const buka = el.hidden;
    el.hidden = !buka;
    b.setAttribute('aria-expanded', String(buka));
    if (buka) { terbuka.add(id); bukaRincian(id); } else terbuka.delete(id);
  });
  $('semua-tugas').addEventListener('click', () => { semuaTugas = !semuaTugas; render(data); });
  $('semua-hadir').addEventListener('click', () => { semuaHadir = !semuaHadir; render(data); });
  $('daftar-tugas').addEventListener('click', async (ev) => {
    const tombol = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-tugas]');
    if (!tombol) return;
    tombol.disabled = true;
    try {
      await api(`/tugas/${tombol.dataset.tugas}/selesai`, {});
      await muat();
    } catch (e) {
      tanganiGalat(e, (t) => ($('pesan').textContent = t));
    }
  });

  api<any>('/saya')
    .then((s) => {
      $('pita-nama').textContent = s.nama;
      $('pita-nim').textContent = s.nim;
      $('pita-prodi').textContent = [s.prodi, s.semester && `Semester ${s.semester}`].filter(Boolean).join(' · ');
      const foto = $('pita-foto');
      if (s.foto) {
        const img = document.createElement('img');
        img.src = s.foto;
        img.alt = '';
        foto.replaceChildren(img);
      } else {
        foto.textContent = s.nama.split(/\s+/).slice(0, 2).map((k: string) => k.charAt(0)).join('');
      }
    })
    .catch(() => {});
  muat();
  setInterval(muat, 60_000);
</script>
